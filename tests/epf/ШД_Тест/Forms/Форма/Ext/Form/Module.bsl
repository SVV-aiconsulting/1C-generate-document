// Служебная тестовая обработка (для разработчика, в поставку не входит).
// Формирует документы по всем шаблонам для нескольких платежных поручений, проверяет запоминание
// исправленных значений и создание форм расширения; пишет протокол test_log.txt.
// Запуск: 1cv8 ENTERPRISE /F база /N пользователь /Execute ШД_Тест.epf /C "каталог вывода"

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Перезапуск = ВыполнитьТестНаСервере(ПараметрЗапуска);
	Если Не Перезапуск Тогда
		ТестФорм();
		Анализ(ПараметрЗапуска);
	КонецЕсли;
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ТестФорм()

	Лог = Новый Массив;
	Лог.Добавить("");
	Лог.Добавить("=== Формы");
	Попытка
		Документ = ТестовыйДокумент();
		Форма = ПолучитьФорму("ОбщаяФорма.ШД_ФормированиеДокумента", Новый Структура("Документ", Документ));
		Лог.Добавить(СтрШаблон("Форма формирования: документ %1, шаблон %2, полей %3",
			Форма.Документ, Форма.Шаблон, Форма.Поля.Количество()));

		ФормаШаблона = ПолучитьФорму("Справочник.ШД_ШаблоныДокументов.ФормаОбъекта", Новый Структура("Ключ", Форма.Шаблон));
		Лог.Добавить("Форма шаблона: " + ФормаШаблона.ОписаниеФайла + "; параметров: " + ФормаШаблона.Объект.Параметры.Количество());
		Лог.Добавить("Справка по полям, строк: " + СтрЧислоСтрок(ФормаШаблона.СправкаПоПолям));

		ФормаНового = ПолучитьФорму("Справочник.ШД_ШаблоныДокументов.ФормаОбъекта");
		Лог.Добавить("Форма нового шаблона: " + Лев(ФормаНового.ОписаниеФайла, 40) + "...");

		ПолучитьФорму("Справочник.ШД_ШаблоныДокументов.ФормаСписка");
		Лог.Добавить("Форма списка шаблонов: ок");
	Исключение
		Лог.Добавить("ОШИБКА ФОРМ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ДописатьЛог(ПараметрЗапуска, Лог);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТестовыйДокумент()

	Возврат ТестовыеДокументы()[0];

КонецФункции

&НаСервереБезКонтекста
Функция ТестовыеДокументы()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 3
	|	П.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления
	|	И П.Контрагент ССЫЛКА Справочник.Контрагенты
	|
	|УПОРЯДОЧИТЬ ПО
	|	П.Дата УБЫВ";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьТестНаСервере(КаталогВывода)

	Лог = Новый Массив;
	Перезапуск = Ложь;
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Лог.Добавить(СтрШаблон("Расширение: %1 версия %2, безопасный режим: %3, активно: %4",
				Расширение.Имя, Расширение.Версия, Расширение.БезопасныйРежим, Расширение.Активно));
		КонецЦикла;

		// Копия базы: отвечаем на вопрос БСП «ИБ перемещена» как «Это копия» (блокирует обмены из копии),
		// чтобы окно с вопросом не мешало автоматическим запускам.
		БлокировкаРаботыСВнешнимиРесурсами.ЗапретитьРаботуСВнешнимиРесурсами();
		Лог.Добавить("Копия базы: подтверждено «Это копия информационной базы»");
		
		// Для теста на копии базы: отключаем безопасный режим расширения (как при установке по инструкции).
		Найденные = РасширенияКонфигурации.Получить(Новый Структура("Имя", "ШаблоныДокументов"));
		Если Найденные.Количество() > 0 И Найденные[0].БезопасныйРежим <> Ложь Тогда
			Найденные[0].БезопасныйРежим = Ложь;
			Найденные[0].Записать();
			Лог.Добавить("ПЕРЕЗАПУСК: безопасный режим расширения отключен, нужен повторный запуск");
			Перезапуск = Истина;
			ВызватьИсключение "ПЕРЕЗАПУСК";
		КонецЕсли;

		// Пересоздаем поставляемый шаблон, чтобы тест шел по актуальной версии из расширения.
		Старый = Справочники.ШД_ШаблоныДокументов.НайтиПоРеквизиту("ИдентификаторПоставляемого", "ДоговорПроцентногоЗайма");
		Если ЗначениеЗаполнено(Старый) Тогда
			Старый.ПолучитьОбъект().Удалить();
		КонецЕсли;
		ШД_ФормированиеДокументов.ОбновитьПоставляемыеШаблоны();

		Документы_ = ТестовыеДокументы();
		Шаблоны = Новый Запрос("ВЫБРАТЬ Ш.Ссылка КАК Ссылка ИЗ Справочник.ШД_ШаблоныДокументов КАК Ш ГДЕ НЕ Ш.ПометкаУдаления");
		Для Каждого Шаблон Из Шаблоны.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка") Цикл
			Для Каждого Док Из Документы_ Цикл
				Лог.Добавить("");
				Лог.Добавить(СтрШаблон("=== %1 / %2", Шаблон, Док));
				Поля = ШД_ФормированиеДокументов.ПоляШаблонаДляДокумента(Шаблон, Док);
				Для Каждого Поле Из Поля Цикл
					Лог.Добавить(СтрШаблон("%1 = %2   [откуда: %5]   <%3: %4>", Поле.Имя, Поле.Значение, Поле.Статус, Поле.Пояснение, Поле.Источник));
				КонецЦикла;
				Результат = ШД_ФормированиеДокументов.СформироватьДокумент(Шаблон, Док, Поля);
				Результат.ДвоичныеДанные.Записать(КаталогВывода + ПолучитьРазделительПути() + Результат.ИмяФайла);
				Лог.Добавить("Файл: " + Результат.ИмяФайла);
			КонецЦикла;

			ТестЗапоминания(Шаблон, Документы_[0], Лог);
		КонецЦикла;
		
		ТестРазорванныхПолей(КаталогВывода, Документы_[0], Лог);
	Исключение
		Если Не Перезапуск Тогда
			Лог.Добавить("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
	КонецПопытки;

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Лог, Символы.ПС));
	Текст.Записать(КаталогВывода + ПолучитьРазделительПути() + "test_log.txt", КодировкаТекста.UTF8);

	Возврат Перезапуск;

КонецФункции

&НаСервереБезКонтекста
Процедура ТестЗапоминания(Шаблон, Док, Лог)

	Лог.Добавить("");
	Лог.Добавить("=== Запоминание исправленных значений");
	ИмяПоля = "Контрагент.РуководительФИОРП";

	Поля = ШД_ФормированиеДокументов.ПоляШаблонаДляДокумента(Шаблон, Док);
	Поле = НайтиПоле(Поля, ИмяПоля);
	Поле.Значение = "Тестова Теста Тестовича";
	ШД_ФормированиеДокументов.ЗапомнитьИсправленныеЗначения(Шаблон, Док, Поля);

	Значение = НайтиПоле(ШД_ФормированиеДокументов.ПоляШаблонаДляДокумента(Шаблон, Док), ИмяПоля).Значение;
	Лог.Добавить(?(Значение = "Тестова Теста Тестовича", "Запомнено: ок", "ОШИБКА: не запомнено, получено " + Значение));

	Поля = ШД_ФормированиеДокументов.ПоляШаблонаДляДокумента(Шаблон, Док);
	Поле = НайтиПоле(Поля, ИмяПоля);
	Поле.Значение = Поле.АвтоЗначение;
	ШД_ФормированиеДокументов.ЗапомнитьИсправленныеЗначения(Шаблон, Док, Поля);
	Поле = НайтиПоле(ШД_ФормированиеДокументов.ПоляШаблонаДляДокумента(Шаблон, Док), ИмяПоля);
	Лог.Добавить(?(Поле.Значение = Поле.АвтоЗначение, "Сброс к автозначению: ок", "ОШИБКА: не сброшено"));

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиПоле(Поля, Имя)

	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = Имя Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет поля " + Имя;

КонецФункции

&НаСервереБезКонтекста
Процедура ДописатьЛог(КаталогВывода, Строки)

	ИмяФайла = КаталогВывода + ПолучитьРазделительПути() + "test_log.txt";
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ИмяФайла, КодировкаТекста.UTF8);
	Для Каждого Строка Из Строки Цикл
		Текст.ДобавитьСтроку(Строка);
	КонецЦикла;
	Текст.Записать(ИмяФайла, КодировкаТекста.UTF8);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ТестРазорванныхПолей(КаталогВывода, Док, Лог)
	
	Лог.Добавить("");
	Лог.Добавить("=== Поля, разорванные разметкой Word");
	ИмяФайла = КаталогВывода + ПолучитьРазделительПути() + "split_template.docx";
	ФайлШаблона = Новый Файл(ИмяФайла);
	Если Не ФайлШаблона.Существует() Тогда
		Лог.Добавить("ОШИБКА: нет файла " + ИмяФайла);
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
	Лог.Добавить("Найдено полей в разорванном шаблоне: " + ШД_ФормированиеДокументов.ИменаПолейДвоичныхДанных(ДвоичныеДанные).Количество());
	
	Поставляемый = Справочники.ШД_ШаблоныДокументов.НайтиПоРеквизиту("ИдентификаторПоставляемого", "ДоговорПроцентногоЗайма");
	Элемент = Поставляемый.Скопировать();
	Элемент.Наименование = "ТЕСТ разорванные поля";
	Элемент.ИдентификаторПоставляемого = "";
	Элемент.ШаблонИмениФайла = "split_result";
	Элемент.ФайлШаблона = Новый ХранилищеЗначения(ДвоичныеДанные);
	Элемент.Записать();
	Попытка
		Результат = ШД_ФормированиеДокументов.СформироватьДокумент(Элемент.Ссылка, Док);
		Результат.ДвоичныеДанные.Записать(КаталогВывода + ПолучитьРазделительПути() + Результат.ИмяФайла);
		Осталось = ШД_ФормированиеДокументов.ИменаПолейДвоичныхДанных(Результат.ДвоичныеДанные).Количество();
		Лог.Добавить(?(Осталось = 0, "Все поля заполнены: ок", "ОШИБКА: осталось незаполненных полей " + Осталось));
	Исключение
		Лог.Добавить("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Элемент.Удалить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура Анализ(КаталогВывода)
	
	Лог = Новый Массив;
	Попытка
		// Организации и ответственные лица
		Выборка = Справочники.Организации.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ЭтоГруппа Или Выборка.ПометкаУдаления Тогда Продолжить; КонецЕсли;
			О = ОтветственныеЛицаБП.ОтветственныеЛица(Выборка.Ссылка, ТекущаяДатаСеанса());
			Лог.Добавить(СтрШаблон("Организация %1: руководитель %2, должность %3, гл.бух %4",
				Выборка.Наименование, О.РуководительПредставление, О.РуководительДолжностьПредставление, О.ГлавныйБухгалтерПредставление));
		КонецЦикла;
		
		// Платежки по займам
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	П.Ссылка КАК Ссылка,
		|	П.Контрагент КАК Контрагент,
		|	П.ДоговорКонтрагента КАК Договор,
		|	П.ВидОперации КАК ВидОперации,
		|	П.НазначениеПлатежа КАК Назначение
		|ИЗ
		|	Документ.ПлатежноеПоручение КАК П
		|ГДЕ
		|	НЕ П.ПометкаУдаления
		|	И (П.НазначениеПлатежа ПОДОБНО ""%займ%"" ИЛИ П.НазначениеПлатежа ПОДОБНО ""%заём%"" ИЛИ П.НазначениеПлатежа ПОДОБНО ""%заем%"")
		|УПОРЯДОЧИТЬ ПО П.Дата УБЫВ";
		Т = Запрос.Выполнить().Выгрузить();
		Лог.Добавить("");
		Лог.Добавить("Платежек с займом в назначении: " + Т.Количество());
		Контрагенты = Новый Соответствие;
		ВидыОпераций = Новый Соответствие;
		Для Каждого С Из Т Цикл
			Счетчик = ВидыОпераций[Строка(С.ВидОперации)]; ВидыОпераций.Вставить(Строка(С.ВидОперации), ?(Счетчик = Неопределено, 0, Счетчик) + 1);
			Если ТипЗнч(С.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
				Контрагенты.Вставить(С.Контрагент, С.Договор);
			КонецЕсли;
		КонецЦикла;
		Для Каждого КЗ Из ВидыОпераций Цикл
			Лог.Добавить("  вид операции: " + КЗ.Ключ + " - " + КЗ.Значение);
		КонецЦикла;
		Лог.Добавить("Разных контрагентов: " + Контрагенты.Количество());
		
		Для Каждого КЗ Из Контрагенты Цикл
			К = КЗ.Ключ;
			Д = КЗ.Значение;
			Лог.Добавить("");
			Лог.Добавить(СтрШаблон("Контрагент: %1 | ИНН %2 | ОГРН %3 | ОКПО %4 | полное: %5",
				К, К.ИНН, К.РегистрационныйНомер, К.КодПоОКПО, К.НаименованиеПолное));
			Св = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(К, ТекущаяДатаСеанса());
			Лог.Добавить("  юр.адрес: " + Св.ЮридическийАдрес + " | факт.адрес: " + Св.ФактическийАдрес);
			КЛ = Новый Запрос("ВЫБРАТЬ К.Наименование, К.Должность, К.Роль, К.ВидКонтактногоЛица ИЗ Справочник.КонтактныеЛица КАК К ГДЕ К.ОбъектВладелец = &К И НЕ К.ПометкаУдаления");
			КЛ.УстановитьПараметр("К", К);
			Для Каждого Л Из КЗ_Выгрузить(КЛ) Цикл
				Лог.Добавить(СтрШаблон("  контактное лицо: %1 | должность: %2 | роль: %3 | вид: %4", Л.Наименование, Л.Должность, Л.Роль, Л.ВидКонтактногоЛица));
			КонецЦикла;
			Если ЗначениеЗаполнено(Д) Тогда
				Лог.Добавить(СтрШаблон("  договор из платежки: %1 | вид %2 | №%3 от %4 | ставка %5 | срок %6 | рук.контрагента %7 / %8 | подписант орг. %9",
					Д, Д.ВидДоговора, Д.Номер, Формат(Д.Дата, "ДФ=dd.MM.yyyy"), Д.ПроцентнаяСтавка, Формат(Д.СрокДействия, "ДФ=dd.MM.yyyy"),
					Д.РуководительКонтрагента, Д.ДолжностьРуководителяКонтрагента, Д.Руководитель));
			Иначе
				Лог.Добавить("  договор в платежке: НЕ УКАЗАН");
			КонецЕсли;
		КонецЦикла;
		
		// Объекты другого расширения про займы
		Лог.Добавить("");
		Для Каждого М Из Метаданные.Справочники Цикл
			Р = М.РасширениеКонфигурации();
			Если Р <> Неопределено И Р.Имя = "РасчетыПроцентовПоЗаймам" Тогда
				Лог.Добавить("Расширение займов, справочник: " + М.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого М Из Метаданные.РегистрыСведений Цикл
			Р = М.РасширениеКонфигурации();
			Если Р <> Неопределено И Р.Имя = "РасчетыПроцентовПоЗаймам" Тогда
				Измерения = Новый Массив;
				Для Каждого Поле Из М.Измерения Цикл Измерения.Добавить(Поле.Имя); КонецЦикла;
				Для Каждого Поле Из М.Ресурсы Цикл Измерения.Добавить(Поле.Имя); КонецЦикла;
				Лог.Добавить("Расширение займов, регистр: " + М.Имя + " (" + СтрСоединить(Измерения, ", ") + ")");
			КонецЕсли;
		КонецЦикла;
		Для Каждого М Из Метаданные.Документы Цикл
			Р = М.РасширениеКонфигурации();
			Если Р <> Неопределено И Р.Имя = "РасчетыПроцентовПоЗаймам" Тогда
				Лог.Добавить("Расширение займов, документ: " + М.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого М Из Метаданные.Справочники.ДоговорыКонтрагентов.Реквизиты Цикл
			Р = М.РасширениеКонфигурации();
			Если Р <> Неопределено Тогда
				Лог.Добавить("Реквизит договора из расширения " + Р.Имя + ": " + М.Имя);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Лог.Добавить("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Лог, Символы.ПС));
	Текст.Записать(КаталогВывода + ПолучитьРазделительПути() + "analysis.txt", КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КЗ_Выгрузить(Запрос)
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

///////////////////////////////////////////////////////////////////////////////////////////////////////
// Расширение «Формирование документов по шаблону».
// Серверная логика: сбор данных платежного поручения, заполнение шаблона DOCX,
// запоминание значений, поставляемые шаблоны.
//
// Поля в шаблоне записываются как {{Имя.Поля}} или {{Имя.Поля|Модификатор|Модификатор}}.
// Модификаторы:
//   ВРЕГ, НРЕГ, ТРЕГ          - регистр всей строки;
//   ПЕРВАЯВРЕГ, ПЕРВАЯНРЕГ    - регистр первой буквы;
//   РП, ДП, ВП, ТП, ПП        - падеж (родительный, дательный, винительный, творительный, предложный);
//   +4Г, -1М, +10Д            - сдвиг даты на годы / месяцы / дни;
//   ПРОПИСЬЮ                  - число прописью (без единиц измерения);
//   любая строка формата 1С   - например ДФ=dd.MM.yyyy, ДЛФ=Д, ЧДЦ=2.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает поля шаблона со значениями, вычисленными по документу.
//
// Параметры:
//  Шаблон         - СправочникСсылка.ШД_ШаблоныДокументов
//  ДокументСсылка - ДокументСсылка.ПлатежноеПоручение
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя           - Строка - имя поля без модификаторов.
//   * Представление - Строка - понятное пользователю название поля.
//   * Значение      - Строка - значение для подстановки (с учетом запомненных).
//   * АвтоЗначение  - Строка - значение, рассчитанное программой.
//   * Запоминать    - Булево - запоминать исправленное пользователем значение.
//   * Статус        - Строка - на что обратить внимание: "Пусто", "Проверить", "Запомнено" или "".
//   * Пояснение     - Строка - почему поле выделено.
//   * АвтоСтатус, АвтоПояснение - Строка - статус и пояснение для значения, рассчитанного программой
//                                         (используются, если пользователь вернет автозначение).
//   * Источник, АвтоИсточник    - Строка - откуда взято значение (платежка, карточка организации и т.д.).
//
Функция ПоляШаблонаДляДокумента(Шаблон, ДокументСсылка) Экспорт

	ДанныеШаблона = ДанныеШаблона(Шаблон);
	Данные = ДанныеДокумента(ДокументСсылка);
	ДобавитьЗначенияПараметровШаблона(Данные, ДанныеШаблона.Параметры, Шаблон);

	Запомненные = ЗапомненныеЗначения(Шаблон, Данные);
	Описания = ОписанияСтандартныхПолей();

	Результат = Новый Массив;
	Для Каждого Имя Из ИменаПолейДвоичныхДанных(ДанныеШаблона.ДвоичныеДанные) Цикл

		Поле = Новый Структура("Имя, Представление, Значение, АвтоЗначение, Запоминать, Статус, Пояснение,
			|АвтоСтатус, АвтоПояснение, Источник, АвтоИсточник",
			Имя, Имя, "", "", Истина, "", "", "", "", "", "");
		ПроверятьПоНастройке = Ложь;

		Параметр = ДанныеШаблона.Параметры.Найти(Имя, "Имя");
		Если Параметр <> Неопределено Тогда
			Если ЗначениеЗаполнено(Параметр.Представление) Тогда
				Поле.Представление = Параметр.Представление;
			КонецЕсли;
			Поле.Запоминать = Параметр.Запоминать;
			ПроверятьПоНастройке = Параметр.Проверять;
		ИначеЕсли Описания[Имя] <> Неопределено Тогда
			Поле.Представление = Описания[Имя];
			// Исправления запоминаем только для реквизитов сторон (например, склонение ФИО),
			// данные самого платежа (сумма, дата и т.п.) у каждого документа свои.
			Поле.Запоминать = СтрНачинаетсяС(Имя, "Организация.") Или СтрНачинаетсяС(Имя, "Контрагент.");
		КонецЕсли;

		Если Данные[Имя] <> Неопределено Тогда
			Поле.АвтоЗначение = ПредставлениеЗначения(Данные[Имя]);
		КонецЕсли;
		Поле.Значение = Поле.АвтоЗначение;

		Поле.АвтоИсточник = Данные["Служебное.Откуда." + Имя];
		Если Поле.АвтоИсточник = Неопределено Тогда
			Поле.АвтоИсточник = НСтр("ru = 'Нет в данных 1С - вводится вручную'");
		КонецЕсли;
		Поле.Источник = Поле.АвтоИсточник;

		ОпределитьСтатусАвтозначения(Поле, Данные, ПроверятьПоНастройке);
		Поле.Статус = Поле.АвтоСтатус;
		Поле.Пояснение = Поле.АвтоПояснение;

		Если Поле.Запоминать Тогда
			Ключ = КлючВладельцаПоля(Имя, Шаблон, Данные);
			Запомненное = Запомненные[Ключ + "#" + Имя];
			// Исправление действует, только пока из 1С приходит то же значение, которое исправляли.
			Если Запомненное <> Неопределено И Запомненное.ИсходноеЗначение = Поле.АвтоЗначение Тогда
				Поле.Значение = Запомненное.Значение;
				Поле.Источник = НСтр("ru = 'Исправлено вами ранее'") + " (" + НСтр("ru = 'в 1С'") + ": "
					+ ?(ПустаяСтрока(Поле.АвтоЗначение), НСтр("ru = 'пусто'"), Поле.АвтоИсточник) + ")";
				Если ПустаяСтрока(Поле.Значение) Тогда
					Поле.Статус = "Пусто";
					Поле.Пояснение = НСтр("ru = 'Не заполнено - впишите значение'");
				ИначеЕсли ПроверятьПоНастройке Тогда
					Поле.Статус = "Проверить";
					Поле.Пояснение = НСтр("ru = 'Отмечено для проверки в настройках шаблона'");
				Иначе
					Поле.Статус = "Запомнено";
					Поле.Пояснение = НСтр("ru = 'Подставлено значение, ранее исправленное вручную'");
					Если ПустаяСтрока(Поле.АвтоЗначение) И Данные["Служебное.ГдеЗаполнить." + Имя] <> Неопределено Тогда
						Поле.Пояснение = Поле.Пояснение + ". " + НСтр("ru = 'Лучше заполнить в 1С'") + ": "
							+ Данные["Служебное.ГдеЗаполнить." + Имя];
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Результат.Добавить(Поле);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Определяет, требует ли рассчитанное программой значение внимания пользователя.
//
Процедура ОпределитьСтатусАвтозначения(Поле, Данные, ПроверятьПоНастройке)

	Имя = Поле.Имя;
	ГдеЗаполнить = Данные["Служебное.ГдеЗаполнить." + Имя];

	Если ПустаяСтрока(Поле.АвтоЗначение) И ЭтоНеобязательноеПоле(Имя, Данные) Тогда
		Поле.АвтоСтатус = "";
		Поле.АвтоПояснение = НСтр("ru = 'Необязательное поле: не заполнено, в договор не попадет'");
	ИначеЕсли ПустаяСтрока(Поле.АвтоЗначение) Тогда
		Поле.АвтоСтатус = "Пусто";
		Если ГдеЗаполнить = Неопределено Тогда
			Поле.АвтоПояснение = НСтр("ru = 'Не заполнено - впишите значение'");
		Иначе
			Поле.АвтоПояснение = НСтр("ru = 'Не заполнено. Заполните в 1С'") + ": " + ГдеЗаполнить
				+ НСтр("ru = ' - и нажмите «Обновить данные». Или впишите значение здесь.'");
		КонецЕсли;
	ИначеЕсли ПроверятьПоНастройке Тогда
		Поле.АвтоСтатус = "Проверить";
		Поле.АвтоПояснение = НСтр("ru = 'Отмечено для проверки в настройках шаблона'");
	ИначеЕсли Данные["Служебное.Источник." + Имя] = "ПоУмолчанию" Тогда
		Поле.АвтоСтатус = "Проверить";
		Поле.АвтоПояснение = НСтр("ru = 'Нет данных в 1С - подставлено значение по умолчанию из настроек шаблона'");
	ИначеЕсли СтрЗаканчиваетсяНа(Имя, "РП") И (СтрНайти(Имя, "ФИО") > 0 Или СтрНайти(Имя, "Должность") > 0) Тогда
		Поле.АвтоСтатус = "Проверить";
		Поле.АвтоПояснение = НСтр("ru = 'Склонено автоматически - проверьте падеж'");
	КонецЕсли;

КонецПроцедуры

// Поля, без которых договор можно подписать: отсутствие не выделяется красным.
// Обязательными остаются наименование, ИНН, ОГРН, юридический адрес, должность и ФИО подписанта и т.п.
//
Функция ЭтоНеобязательноеПоле(Имя, Данные)

	Если Данные["Служебное.Необязательно." + Имя] = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Окончание = Сред(Имя, СтрНайти(Имя, ".") + 1);
	Возврат СтрРазделить("ОКПО,ФактическийАдрес,ПочтовыйАдрес,Телефон,Email,БанкАдрес,БанкГород", ",").Найти(Окончание) <> Неопределено
		И (СтрНачинаетсяС(Имя, "Организация.") Или СтрНачинаетсяС(Имя, "Контрагент."));

КонецФункции

// Формирует документ по шаблону.
//
// Параметры:
//  Шаблон         - СправочникСсылка.ШД_ШаблоныДокументов
//  ДокументСсылка - ДокументСсылка.ПлатежноеПоручение
//  Поля           - Массив из Структура - см. ПоляШаблонаДляДокумента (значения могут быть исправлены).
//                 - Неопределено - значения будут рассчитаны автоматически.
//
// Возвращаемое значение:
//  Структура:
//   * ДвоичныеДанные - ДвоичныеДанные - файл DOCX.
//   * ИмяФайла       - Строка - имя файла с расширением.
//
Функция СформироватьДокумент(Шаблон, ДокументСсылка, Знач Поля = Неопределено) Экспорт

	Если Поля = Неопределено Тогда
		Поля = ПоляШаблонаДляДокумента(Шаблон, ДокументСсылка);
	КонецЕсли;

	ДанныеШаблона = ДанныеШаблона(Шаблон);
	Данные = ДанныеДокумента(ДокументСсылка);
	ДобавитьЗначенияПараметровШаблона(Данные, ДанныеШаблона.Параметры, Шаблон);

	// Строковые значения полей (то, что видел и мог исправить пользователь).
	// Если значение не исправлено, модификаторы применяются к исходному типизированному значению.
	Значения = Новый Соответствие;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Значение = Поле.АвтоЗначение И Данные[Поле.Имя] <> Неопределено Тогда
			Значения.Вставить(Поле.Имя, Данные[Поле.Имя]);
		Иначе
			Значения.Вставить(Поле.Имя, Поле.Значение);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура("ДвоичныеДанные, ИмяФайла");
	Результат.ДвоичныеДанные = ЗаполнитьШаблонDOCX(ДанныеШаблона.ДвоичныеДанные, Значения);

	ШаблонИмени = ДанныеШаблона.ШаблонИмениФайла;
	Если ПустаяСтрока(ШаблонИмени) Тогда
		ШаблонИмени = ДанныеШаблона.Наименование;
	КонецЕсли;
	Результат.ИмяФайла = БезопасноеИмяФайла(ЗаполнитьСтроку(ШаблонИмени, Значения)) + ".docx";

	Возврат Результат;

КонецФункции

// Сохраняет значения полей, которые пользователь исправил вручную, для повторного использования.
//
// Параметры:
//  Шаблон         - СправочникСсылка.ШД_ШаблоныДокументов
//  ДокументСсылка - ДокументСсылка.ПлатежноеПоручение
//  Поля           - Массив из Структура - см. ПоляШаблонаДляДокумента.
//
Процедура ЗапомнитьИсправленныеЗначения(Шаблон, ДокументСсылка, Поля) Экспорт

	Данные = ДанныеДокумента(ДокументСсылка);

	Для Каждого Поле Из Поля Цикл

		Если Не Поле.Запоминать Тогда
			Продолжить;
		КонецЕсли;

		Ключ = КлючВладельцаПоля(Поле.Имя, Шаблон, Данные);
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		МенеджерЗаписи = РегистрыСведений.ШД_ЗапомненныеЗначения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Владелец = Ключ;
		МенеджерЗаписи.ИмяПоля = Поле.Имя;

		Если Поле.Значение = Поле.АвтоЗначение Тогда
			// Значение совпадает с рассчитанным - запоминать нечего, старое запомненное значение удаляем.
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Удалить();
			КонецЕсли;
		Иначе
			МенеджерЗаписи.Значение = Поле.Значение;
			МенеджерЗаписи.ИсходноеЗначение = Поле.АвтоЗначение;
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Ссылки на карточки, из которых берутся данные (для открытия из формы формирования).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПлатежноеПоручение
//
// Возвращаемое значение:
//  Структура - Организация, Контрагент, Договор.
//
Функция СсылкиНаКарточки(ДокументСсылка) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация, Контрагент, ДоговорКонтрагента");
	Возврат Новый Структура("Организация, Контрагент, Договор",
		Реквизиты.Организация, Реквизиты.Контрагент, Реквизиты.ДоговорКонтрагента);

КонецФункции

// Возвращает имена полей {{...}}, найденных в файле DOCX (без модификаторов, без повторов).
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - файл DOCX.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаПолейДвоичныхДанных(ДвоичныеДанные) Экспорт

	Результат = Новый Массив;
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	КаталогРаспаковки = РаспаковатьDOCX(ДвоичныеДанные);
	Попытка
		Для Каждого ИмяЧасти Из ЧастиДокументаСТекстом(КаталогРаспаковки) Цикл
			Текст = ОбъединитьРазорванныеПоля(ПрочитатьТекстФайла(ИмяЧасти));
			Для Каждого Выражение Из ВыраженияПолей(Текст) Цикл
				Имя = ИмяПоляВыражения(Выражение);
				Если Не ПустаяСтрока(Имя) И Результат.Найти(Имя) = Неопределено Тогда
					Результат.Добавить(Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		УдалитьВременныйКаталог(КаталогРаспаковки);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьВременныйКаталог(КаталогРаспаковки);

	Возврат Результат;

КонецФункции

// Признак того, что поле рассчитывается программой автоматически (не требует описания в шаблоне).
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСтандартноеПоле(Имя) Экспорт

	Возврат ОписанияСтандартныхПолей()[Имя] <> Неопределено;

КонецФункции

// Текст справки со списком полей, которые можно использовать в шаблонах.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстСправкиПоПолям() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Поле вставляется в шаблон Word в двойных фигурных скобках, например {{Организация.ИНН}}.'"));
	Строки.Добавить(НСтр("ru = 'Можно добавить модификаторы через |, например {{Организация.Наименование|ВРЕГ}} или {{Документ.Дата|ДФ=dd.MM.yyyy}}.'"));
	Строки.Добавить(НСтр("ru = 'Модификаторы: ВРЕГ, НРЕГ, ТРЕГ, ПЕРВАЯВРЕГ, ПЕРВАЯНРЕГ, РП/ДП/ВП/ТП/ПП (падеж), +4Г/-1М/+10Д (сдвиг даты), ПРОПИСЬЮ, ПОДПИСЬ:текст (подпись только при заполненном значении), НОВАЯСТРОКА (перенос строки перед заполненным значением), формат 1С (ДФ=..., ЧДЦ=...).'"));
	Строки.Добавить(НСтр("ru = 'Поля, которых нет в списке ниже, становятся параметрами шаблона: их значения вводятся при формировании.'"));
	Строки.Добавить("");
	Для Каждого КлючИЗначение Из ОписанияСтандартныхПолей() Цикл
		Строки.Добавить("{{" + КлючИЗначение.Ключ + "}} - " + КлючИЗначение.Значение);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Создает в справочнике шаблоны, поставляемые с расширением, если их там еще нет,
// и обновляет их при выходе новой версии расширения, если пользователь не изменял шаблон
// (файл и параметры совпадают с ранее поставленной версией). Измененные пользователем шаблоны не трогаются.
//
Процедура ОбновитьПоставляемыеШаблоны() Экспорт

	Попытка
		ТекстОписания = ПолучитьСтрокуИзДвоичныхДанных(ПолучитьОбщийМакет("ШД_ПоставляемыеШаблоны"), КодировкаТекста.UTF8);
	Исключение
		Возврат;
	КонецПопытки;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстОписания);
	Описания = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Для Каждого Описание Из Описания Цикл

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Шаблоны.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ШД_ШаблоныДокументов КАК Шаблоны
		|ГДЕ
		|	Шаблоны.ИдентификаторПоставляемого = &Идентификатор";
		Запрос.УстановитьПараметр("Идентификатор", Описание.Идентификатор);
		Выборка = Запрос.Выполнить().Выбрать();

		ФайлПоставки = ПолучитьОбщийМакет(Описание.Макет);
		Если Выборка.Следующий() Тогда
			Элемент = Выборка.Ссылка.ПолучитьОбъект();
			ТекущаяВерсия = ВерсияШаблона(Элемент.ФайлШаблона.Получить(), Элемент.Параметры.Выгрузить());
			Если ЗначениеЗаполнено(Элемент.ВерсияПоставки) И Элемент.ВерсияПоставки <> ТекущаяВерсия Тогда
				Продолжить; // Шаблон изменен пользователем - не трогаем.
			КонецЕсли;
		Иначе
			Элемент = Справочники.ШД_ШаблоныДокументов.СоздатьЭлемент();
			Элемент.Наименование = Описание.Наименование;
			Элемент.ИдентификаторПоставляемого = Описание.Идентификатор;
		КонецЕсли;

		Элемент.Описание = Описание.Описание;
		Элемент.ШаблонИмениФайла = Описание.ШаблонИмениФайла;
		Элемент.ИмяФайлаШаблона = Описание.ИмяФайла;
		Элемент.ФайлШаблона = Новый ХранилищеЗначения(ФайлПоставки, Новый СжатиеДанных(9));
		Элемент.Параметры.Очистить();
		Для Каждого ОписаниеПараметра Из Описание.Параметры Цикл
			СтрокаПараметра = Элемент.Параметры.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПараметра, ОписаниеПараметра);
		КонецЦикла;
		НоваяВерсия = ВерсияШаблона(ФайлПоставки, Элемент.Параметры.Выгрузить());
		Если Элемент.ВерсияПоставки = НоваяВерсия И Не Элемент.ЭтоНовый() Тогда
			Продолжить; // Уже актуальная версия.
		КонецЕсли;
		Элемент.ВерсияПоставки = НоваяВерсия;
		Элемент.Записать();

	КонецЦикла;

КонецПроцедуры

// Контрольная сумма файла и параметров шаблона (для обнаружения изменений пользователем).
//
Функция ВерсияШаблона(ДвоичныеДанные, Параметры)

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		Хеширование.Добавить(ДвоичныеДанные);
	КонецЕсли;
	Для Каждого Параметр Из Параметры Цикл
		Хеширование.Добавить(СтрШаблон("%1|%2|%3|%4|%5;", Параметр.Имя, Параметр.Представление,
			Параметр.ЗначениеПоУмолчанию, Параметр.Запоминать, Параметр.Проверять));
	КонецЦикла;

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДанныеШаблона

Функция ДанныеШаблона(Шаблон)

	Объект = Шаблон.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Шаблон документа не найден.'");
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Наименование", Объект.Наименование);
	Результат.Вставить("ШаблонИмениФайла", Объект.ШаблонИмениФайла);
	Результат.Вставить("ДвоичныеДанные", Объект.ФайлШаблона.Получить());
	Результат.Вставить("Параметры", Объект.Параметры.Выгрузить());

	Если ТипЗнч(Результат.ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В шаблоне «%1» не загружен файл Word (.docx).'"), Объект.Наименование);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Вычисляет значения параметров шаблона (полей, которые не рассчитываются автоматически)
// по выражениям «Значение по умолчанию» и добавляет их в Данные.
//
Процедура ДобавитьЗначенияПараметровШаблона(Данные, Параметры, Шаблон = Неопределено)

	ГдеНастройка = НСтр("ru = 'Шаблоны документов - шаблон - закладка «Параметры шаблона», колонка «Значение по умолчанию»'");
	Для Каждого Параметр Из Параметры Цикл
		Если ПустаяСтрока(Параметр.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Имя = СокрЛП(Параметр.Имя);
		ЭтоЗначениеПоУмолчанию = Ложь;
		ИспользованноеПоле = "";
		Значение = ВычислитьВыражениеПоУмолчанию(Параметр.ЗначениеПоУмолчанию, Данные, ЭтоЗначениеПоУмолчанию, ИспользованноеПоле);

		Если ПустаяСтрока(ИспользованноеПоле) Тогда
			Откуда = НСтр("ru = 'Значение по умолчанию из настроек шаблона'");
		Иначе
			Откуда = Данные["Служебное.Откуда." + ИспользованноеПоле];
			Если Откуда = Неопределено Тогда
				Откуда = ИспользованноеПоле;
			КонецЕсли;
			Если СтрНайти(Параметр.ЗначениеПоУмолчанию, "{{" + ИспользованноеПоле + "|") > 0 Тогда
				Откуда = Откуда + НСтр("ru = ' (с преобразованием по настройке шаблона)'");
			КонецЕсли;
		КонецЕсли;
		УстановитьПоле(Данные, Имя, Значение, Откуда, ГдеНастройка);
		Если ЭтоЗначениеПоУмолчанию Тогда
			Данные.Вставить("Служебное.Источник." + Имя, "ПоУмолчанию");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Выражение может содержать поля {{...}} и альтернативы через «||»:
// берется первая альтернатива с непустым результатом.
// Если альтернатива состоит из одного поля, возвращается типизированное значение (например, дата).
// ЭтоЗначениеПоУмолчанию - Булево - возвращается Истина, если значение взято не из первой альтернативы
// или альтернатива не содержит полей (постоянное значение, например «15,0»): данных в 1С не нашлось.
//
Функция ВычислитьВыражениеПоУмолчанию(Выражение, Данные, ЭтоЗначениеПоУмолчанию = Ложь, ИспользованноеПоле = "")

	НомерАльтернативы = 0;
	Для Каждого Альтернатива Из СтрРазделить(СтрЗаменить(Выражение, "||", Символы.ПС), Символы.ПС, Ложь) Цикл

		НомерАльтернативы = НомерАльтернативы + 1;
		Альтернатива = СокрЛП(Альтернатива);
		Выражения = ВыраженияПолей(Альтернатива);

		Если Выражения.Количество() = 1 И Альтернатива = "{{" + Выражения[0] + "}}" Тогда
			Части = СтрРазделить(Выражения[0], "|", Ложь);
			Значение = Данные[СокрЛП(Части[0])];
			Для Индекс = 1 По Части.ВГраница() Цикл
				Значение = ПрименитьМодификатор(Значение, СокрЛП(Части[Индекс]), СокрЛП(Части[0]));
			КонецЦикла;
		Иначе
			Значение = ЗаполнитьСтроку(Альтернатива, Данные);
		КонецЕсли;

		Если ЗначениеЗаполнено(Значение) Тогда
			ЭтоЗначениеПоУмолчанию = НомерАльтернативы > 1 Или Выражения.Количество() = 0;
			ИспользованноеПоле = ?(Выражения.Количество() > 0, ИмяПоляВыражения(Выражения[0]), "");
			Возврат Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ДанныеДокумента

// Собирает данные для полей шаблона.
//
// Принцип:
//  1. Платежное поручение - первичный источник: номер, дата, сумма, ИНН/КПП плательщика и получателя
//     (в том виде, в каком они ушли в банк), банковские счета сторон.
//  2. По платежке определяются организация (плательщик, Заимодавец) и контрагент (получатель, Заемщик);
//     остальные реквизиты берутся из их карточек: наименование, ОГРН, ОКПО, адреса,
//     руководитель (организация - «Ответственные лица», контрагент - «Контактные лица»).
//  3. Карточка договора, выбранного в платежке (если выбран), - только запасной источник подписантов
//     и источник полей Договор1С.* для шаблонов, которым они нужны.
// Для каждого поля сохраняется, откуда взято значение («Служебное.Откуда.<Поле>»)
// и где его заполнить в 1С, если оно пустое («Служебное.ГдеЗаполнить.<Поле>»).
//
// Возвращаемое значение:
//  Соответствие - ключ: имя поля (например «Организация.ИНН»), значение: значение поля.
//
Функция ДанныеДокумента(ДокументСсылка) Экспорт

	Данные = Новый Соответствие;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Номер, Дата, СуммаДокумента, СуммаНДС, НазначениеПлатежа, Организация, Контрагент,
		|СчетОрганизации, СчетКонтрагента, ДоговорКонтрагента, ВалютаДокумента,
		|ИННПлательщика, КПППлательщика, ИННПолучателя, КПППолучателя, ТекстПлательщика, ТекстПолучателя");

	Данные.Вставить("Служебное.Организация", Реквизиты.Организация);
	Данные.Вставить("Служебное.Контрагент", Реквизиты.Контрагент);
	Данные.Вставить("Служебное.Договор", Реквизиты.ДоговорКонтрагента);

	// 1. Платежное поручение
	ИзПлатежки = НСтр("ru = 'Платежное поручение'");
	Номер = Реквизиты.Номер;
	Попытка
		Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер, Истина, Истина);
	Исключение
		Номер = СокрЛП(Номер);
	КонецПопытки;
	УстановитьПоле(Данные, "Документ.Номер", Номер, ИзПлатежки + ": " + НСтр("ru = 'номер'"));
	УстановитьПоле(Данные, "Документ.Дата", НачалоДня(Реквизиты.Дата), ИзПлатежки + ": " + НСтр("ru = 'дата'"));
	УстановитьПоле(Данные, "Документ.Сумма", Реквизиты.СуммаДокумента, ИзПлатежки + ": " + НСтр("ru = 'сумма'"));
	УстановитьПоле(Данные, "Документ.СуммаНДС", Реквизиты.СуммаНДС, ИзПлатежки + ": " + НСтр("ru = 'сумма НДС'"));
	УстановитьПоле(Данные, "Документ.НазначениеПлатежа", СокрЛП(Реквизиты.НазначениеПлатежа),
		ИзПлатежки + ": " + НСтр("ru = 'назначение платежа'"));
	УстановитьПоле(Данные, "Документ.Валюта", Строка(Реквизиты.ВалютаДокумента), ИзПлатежки + ": " + НСтр("ru = 'валюта'"));
	УстановитьПоле(Данные, "ТекущаяДата", ТекущаяДатаСеанса(), НСтр("ru = 'Текущая дата'"));
	ДобавитьДанныеСуммы(Данные, Реквизиты.СуммаДокумента, ИзПлатежки + ": " + НСтр("ru = 'сумма'"));

	// 3. Карточка договора из платежки (не обязательна)
	ДанныеДоговора = ДанныеДоговора(Реквизиты.ДоговорКонтрагента);
	ИзДоговора = НСтр("ru = 'Карточка договора, выбранного в платежке'");
	ГдеДоговор = НСтр("ru = 'Платежное поручение, поле «Договор» - карточка договора'");
	УстановитьПоле(Данные, "Договор1С.Номер", СокрЛП(ДанныеДоговора.Номер), ИзДоговора, ГдеДоговор);
	УстановитьПоле(Данные, "Договор1С.Дата", ДанныеДоговора.Дата, ИзДоговора, ГдеДоговор);
	УстановитьПоле(Данные, "Договор1С.Наименование", СокрЛП(ДанныеДоговора.Наименование), ИзДоговора, ГдеДоговор);
	УстановитьПоле(Данные, "Договор1С.ПроцентнаяСтавка", ДанныеДоговора.ПроцентнаяСтавка, ИзДоговора, ГдеДоговор);
	УстановитьПоле(Данные, "Договор1С.СрокДействия", ДанныеДоговора.СрокДействия, ИзДоговора, ГдеДоговор);

	// 2. Организация (плательщик, Заимодавец)
	Сведения = СведенияОКомпании(Реквизиты.Организация, Реквизиты.Дата, Реквизиты.СчетОрганизации);
	ДобавитьДанныеСтороны(Данные, "Организация", Сведения,
		Реквизиты.ИННПлательщика, Реквизиты.КПППлательщика, Реквизиты.ТекстПлательщика);
	Руководитель = РуководительОрганизации(Реквизиты.Организация, Реквизиты.Дата, ДанныеДоговора);
	ДобавитьДанныеРуководителя(Данные, "Организация", Сведения, Руководитель);

	// 2. Контрагент (получатель, Заемщик)
	Сведения = СведенияОКомпании(Реквизиты.Контрагент, Реквизиты.Дата, Реквизиты.СчетКонтрагента);
	ДобавитьДанныеСтороны(Данные, "Контрагент", Сведения,
		Реквизиты.ИННПолучателя, Реквизиты.КПППолучателя, Реквизиты.ТекстПолучателя);
	Руководитель = РуководительКонтрагента(Реквизиты.Контрагент, ДанныеДоговора);
	ДобавитьДанныеРуководителя(Данные, "Контрагент", Сведения, Руководитель);

	Возврат Данные;

КонецФункции

Процедура УстановитьПоле(Данные, Имя, Значение, Откуда, ГдеЗаполнить = "")

	Данные.Вставить(Имя, Значение);
	Данные.Вставить("Служебное.Откуда." + Имя, Откуда);
	Если Не ПустаяСтрока(ГдеЗаполнить) Тогда
		Данные.Вставить("Служебное.ГдеЗаполнить." + Имя, ГдеЗаполнить);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьДанныеСуммы(Данные, Сумма, Откуда)

	Рубли = Цел(Сумма);
	Копейки = Окр((Сумма - Рубли) * 100);

	РублиЧислом = Формат(Рубли, "ЧН=0; ЧГ=3,0");
	КопейкиЧислом = Формат(Копейки, "ЧЦ=2; ЧВН=; ЧН=00");
	РублиПрописью = ЧислоПрописьюБезЕдиниц(Рубли);
	СловоРубль = ФормаСловаПоЧислу(Рубли, "рубль", "рубля", "рублей");
	СловоКопейка = ФормаСловаПоЧислу(Копейки, "копейка", "копейки", "копеек");

	УстановитьПоле(Данные, "Сумма.Число", Формат(Сумма, "ЧДЦ=2; ЧН=0,00; ЧГ=3,0"), Откуда);
	УстановитьПоле(Данные, "Сумма.Рубли", РублиЧислом, Откуда);
	УстановитьПоле(Данные, "Сумма.Копейки", КопейкиЧислом, Откуда);
	УстановитьПоле(Данные, "Сумма.РублиПрописью", РублиПрописью, Откуда);
	УстановитьПоле(Данные, "Сумма.Прописью", ВРег(Лев(РублиПрописью, 1)) + Сред(РублиПрописью, 2)
		+ " " + СловоРубль + " " + КопейкиЧислом + " " + СловоКопейка, Откуда);
	УстановитьПоле(Данные, "Сумма.Полностью", РублиЧислом + " (" + РублиПрописью + ") " + СловоРубль
		+ " " + КопейкиЧислом + " " + СловоКопейка, Откуда);

КонецПроцедуры

Функция ДанныеДоговора(Договор)

	ДанныеДоговора = Новый Структура("Номер, Дата, Наименование, ПроцентнаяСтавка, СрокДействия,
		|Руководитель, ДолжностьРуководителя, РуководительКонтрагента, ДолжностьРуководителяКонтрагента,
		|ПолРуководителяКонтрагента", "", '00010101', "", 0, '00010101');
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат ДанныеДоговора;
	КонецЕсли;

	Попытка
		ЗаполнитьЗначенияСвойств(ДанныеДоговора, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Договор, "Номер, Дата, Наименование, ПроцентнаяСтавка, СрокДействия,
			|Руководитель, ДолжностьРуководителя, РуководительКонтрагента, ДолжностьРуководителяКонтрагента,
			|ПолРуководителяКонтрагента"));
	Исключение
		ЗаполнитьЗначенияСвойств(ДанныеДоговора, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Договор, "Номер, Дата, Наименование"));
	КонецПопытки;

	Возврат ДанныеДоговора;

КонецФункции

// Реквизиты стороны договора: ИНН/КПП и счет - из платежного поручения, остальное - из карточки.
//
Процедура ДобавитьДанныеСтороны(Данные, Префикс, Сведения, ИННИзПлатежки, КППИзПлатежки, НаименованиеИзПлатежки)

	ЭтоОрганизация = (Префикс = "Организация");
	Если ЭтоОрганизация Тогда
		Карточка = НСтр("ru = 'Карточка организации'");
		ГдеКарточка = НСтр("ru = 'Справочники - Организации - карточка организации'");
		Сторона = НСтр("ru = 'плательщика'");
	Иначе
		Карточка = НСтр("ru = 'Карточка контрагента'");
		ГдеКарточка = НСтр("ru = 'Справочники - Контрагенты - карточка контрагента'");
		Сторона = НСтр("ru = 'получателя'");
	КонецЕсли;
	ИзПлатежки = НСтр("ru = 'Платежное поручение'");

	// Наименование - из карточки (краткое юридическое наименование); если карточки нет - из платежки.
	Если ПустаяСтрока(Сведения.Наименование) Тогда
		УстановитьПоле(Данные, Префикс + ".Наименование", КавычкиЕлочки(СокрЛП(НаименованиеИзПлатежки)),
			ИзПлатежки + ": " + НСтр("ru = 'наименование'") + " " + Сторона, ГдеКарточка);
		УстановитьПоле(Данные, Префикс + ".ПолноеНаименование", КавычкиЕлочки(СокрЛП(НаименованиеИзПлатежки)),
			ИзПлатежки + ": " + НСтр("ru = 'наименование'") + " " + Сторона, ГдеКарточка);
	Иначе
		УстановитьПоле(Данные, Префикс + ".Наименование", Сведения.Наименование,
			Карточка + ": " + НСтр("ru = 'наименование'"), ГдеКарточка + НСтр("ru = ', поле «Полное наименование»'"));
		УстановитьПоле(Данные, Префикс + ".ПолноеНаименование", Сведения.ПолноеНаименование,
			Карточка + ": " + НСтр("ru = 'полное наименование'"), ГдеКарточка + НСтр("ru = ', поле «Полное наименование»'"));
	КонецЕсли;

	// ИНН и КПП - как они указаны в платежке (ушли в банк); если там пусто - из карточки.
	ДобавитьРеквизитИзПлатежкиИлиКарточки(Данные, Префикс + ".ИНН", ИННИзПлатежки, Сведения.ИНН,
		ИзПлатежки + ": " + НСтр("ru = 'ИНН'") + " " + Сторона, Карточка + ": " + НСтр("ru = 'ИНН'"),
		ГдеКарточка + НСтр("ru = ', поле «ИНН»'"));
	Если Сведения.ЭтоИП Тогда
		УстановитьПоле(Данные, Префикс + ".КПП", "", НСтр("ru = 'У индивидуального предпринимателя КПП нет'"));
		Данные.Вставить("Служебное.Необязательно." + Префикс + ".КПП", Истина);
	Иначе
		ДобавитьРеквизитИзПлатежкиИлиКарточки(Данные, Префикс + ".КПП", КППИзПлатежки, Сведения.КПП,
			ИзПлатежки + ": " + НСтр("ru = 'КПП'") + " " + Сторона, Карточка + ": " + НСтр("ru = 'КПП'"),
			ГдеКарточка + НСтр("ru = ', поле «КПП»'"));
	КонецЕсли;

	// Регистрационные данные и адреса - из карточки.
	УстановитьПоле(Данные, Префикс + ".ОГРН", Сведения.ОГРН, Карточка + ": " + НСтр("ru = 'ОГРН'"),
		ГдеКарточка + НСтр("ru = ', поле «ОГРН» (для ИП - «ОГРНИП»)'"));
	УстановитьПоле(Данные, Префикс + ".ОКПО", Сведения.ОКПО, Карточка + ": " + НСтр("ru = 'код по ОКПО'"),
		ГдеКарточка + НСтр("ru = ', поле «Код по ОКПО» (раздел с кодами)'"));
	УстановитьПоле(Данные, Префикс + ".ЮридическийАдрес", Сведения.ЮридическийАдрес,
		Карточка + ": " + НСтр("ru = 'юридический адрес'"), ГдеКарточка + НСтр("ru = ', раздел «Адрес и телефон» - «Юридический адрес»'"));
	УстановитьПоле(Данные, Префикс + ".Город", ГородИзАдреса(Сведения.ЮридическийАдрес),
		Карточка + ": " + НСтр("ru = 'город из юридического адреса'"), ГдеКарточка + НСтр("ru = ', раздел «Адрес и телефон» - «Юридический адрес»'"));
	УстановитьПоле(Данные, Префикс + ".ФактическийАдрес", Сведения.ФактическийАдрес,
		Карточка + ": " + НСтр("ru = 'фактический адрес'"), ГдеКарточка + НСтр("ru = ', раздел «Адрес и телефон» - «Фактический адрес»'"));
	УстановитьПоле(Данные, Префикс + ".ПочтовыйАдрес", Сведения.ПочтовыйАдрес,
		Карточка + ": " + НСтр("ru = 'почтовый адрес'"), ГдеКарточка + НСтр("ru = ', раздел «Адрес и телефон» - «Почтовый адрес»'"));
	УстановитьПоле(Данные, Префикс + ".Телефон", Сведения.Телефон,
		Карточка + ": " + НСтр("ru = 'телефон'"), ГдеКарточка + НСтр("ru = ', раздел «Адрес и телефон» - «Телефон»'"));
	УстановитьПоле(Данные, Префикс + ".Email", Сведения.Email,
		Карточка + ": " + НСтр("ru = 'электронная почта'"), ГдеКарточка + НСтр("ru = ', раздел «Адрес и телефон» - «Электронная почта»'"));

	// Банковские реквизиты - счет, выбранный в платежке.
	ИзСчета = ИзПлатежки + ": " + ?(ЭтоОрганизация, НСтр("ru = 'счет организации'"), НСтр("ru = 'счет получателя'"));
	ГдеСчет = ИзПлатежки + ": " + ?(ЭтоОрганизация, НСтр("ru = 'поле «Счет организации»'"), НСтр("ru = 'поле «Счет получателя»'"))
		+ НСтр("ru = ' - карточка банковского счета и банка'");
	УстановитьПоле(Данные, Префикс + ".РасчетныйСчет", Сведения.РасчетныйСчет, ИзСчета, ГдеСчет);
	УстановитьПоле(Данные, Префикс + ".Банк", Сведения.Банк, ИзСчета + НСтр("ru = ', банк'"), ГдеСчет);
	УстановитьПоле(Данные, Префикс + ".БИК", Сведения.БИК, ИзСчета + НСтр("ru = ', БИК банка'"), ГдеСчет);
	УстановитьПоле(Данные, Префикс + ".КоррСчет", Сведения.КоррСчет, ИзСчета + НСтр("ru = ', корр. счет банка'"), ГдеСчет);
	УстановитьПоле(Данные, Префикс + ".БанкГород", Сведения.БанкГород, ИзСчета + НСтр("ru = ', город банка'"), ГдеСчет);
	УстановитьПоле(Данные, Префикс + ".БанкАдрес", Сведения.БанкАдрес, ИзСчета + НСтр("ru = ', адрес банка'"), ГдеСчет);

КонецПроцедуры

// Город из адреса: «183038, Мурманская обл, г Мурманск, ул ...» -> «г. Мурманск».
// Если город не найден (например, адрес в поселке), возвращается пустая строка.
//
Функция ГородИзАдреса(Адрес)
	
	Для Каждого Часть Из СтрРазделить(Адрес, ",", Ложь) Цикл
		Часть = СокрЛП(Часть);
		ЧастьВРег = ВРег(Часть);
		Если СтрНачинаетсяС(ЧастьВРег, "Г.О.") Или СтрНачинаетсяС(ЧастьВРег, "Г.П.") Или СтрНачинаетсяС(ЧастьВРег, "Г.Ф.З") Тогда
			Продолжить; // городской округ / городское поселение - это не город
		ИначеЕсли СтрНачинаетсяС(ЧастьВРег, "Г. ") Или СтрНачинаетсяС(ЧастьВРег, "Г ") Тогда
			Название = СокрЛП(Сред(Часть, 3));
		ИначеЕсли СтрНачинаетсяС(ЧастьВРег, "Г.") Тогда
			Название = СокрЛП(Сред(Часть, 3));
		ИначеЕсли СтрНачинаетсяС(ЧастьВРег, "ГОРОД ") Тогда
			Название = СокрЛП(Сред(Часть, 7));
		ИначеЕсли СтрЗаканчиваетсяНа(ЧастьВРег, " Г") Или СтрЗаканчиваетсяНа(ЧастьВРег, " Г.") Тогда
			Название = СокрЛП(Лев(Часть, СтрНайти(Часть, " ", НаправлениеПоиска.СКонца) - 1));
		Иначе
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Название) Тогда
			Возврат "г. " + ВРег(Лев(Название, 1)) + Сред(Название, 2);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Процедура ДобавитьРеквизитИзПлатежкиИлиКарточки(Данные, Имя, ИзПлатежки, ИзКарточки, ОткудаПлатежка, ОткудаКарточка, ГдеЗаполнить)

	Если Не ПустаяСтрока(ИзПлатежки) Тогда
		УстановитьПоле(Данные, Имя, СокрЛП(ИзПлатежки), ОткудаПлатежка, ГдеЗаполнить);
	Иначе
		УстановитьПоле(Данные, Имя, СокрЛП(ИзКарточки), ОткудаКарточка, ГдеЗаполнить);
	КонецЕсли;

КонецПроцедуры

Функция НовыеСведенияОКомпании()

	Возврат Новый Структура("Наименование, ПолноеНаименование, ИНН, КПП, ОГРН, ОКПО,
		|ЮридическийАдрес, ФактическийАдрес, ПочтовыйАдрес, Телефон, Email,
		|РасчетныйСчет, Банк, БИК, КоррСчет, БанкГород, БанкАдрес, ЭтоИП, ФИОИП", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "", "", "", "", Ложь, "");

КонецФункции

// Реквизиты организации или контрагента из карточки средствами Бухгалтерии предприятия
// (банковские реквизиты - по счету, выбранному в платежке).
//
Функция СведенияОКомпании(Компания, Дата, БанковскийСчет)

	Сведения = НовыеСведенияОКомпании();
	Если Не ЗначениеЗаполнено(Компания) Тогда
		Возврат Сведения;
	КонецЕсли;

	Попытка
		Реквизиты = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Компания, Дата, БанковскийСчет);
	Исключение
		Реквизиты = Неопределено;
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Формирование документов по шаблону'"), УровеньЖурналаРегистрации.Предупреждение,,
			Компания, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Реквизиты <> Неопределено Тогда
		Сведения.ПолноеНаименование = СвойствоСтрокой(Реквизиты, "ПолноеНаименование");
		Сведения.ИНН                = СвойствоСтрокой(Реквизиты, "ИНН");
		Сведения.КПП                = СвойствоСтрокой(Реквизиты, "КПП");
		Сведения.ОГРН               = СвойствоСтрокой(Реквизиты, "ОГРН");
		Сведения.ОКПО               = СвойствоСтрокой(Реквизиты, "КодПоОКПО");
		Сведения.ЮридическийАдрес   = СвойствоСтрокой(Реквизиты, "ЮридическийАдрес");
		Сведения.ФактическийАдрес   = СвойствоСтрокой(Реквизиты, "ФактическийАдрес");
		Сведения.ПочтовыйАдрес      = СвойствоСтрокой(Реквизиты, "ПочтовыйАдрес");
		Сведения.Телефон            = СвойствоСтрокой(Реквизиты, "Телефоны");
		Сведения.Email              = СвойствоСтрокой(Реквизиты, "Email");
		Сведения.РасчетныйСчет      = СвойствоСтрокой(Реквизиты, "НомерСчета");
		Сведения.Банк               = СвойствоСтрокой(Реквизиты, "Банк");
		Сведения.БИК                = СвойствоСтрокой(Реквизиты, "БИК");
		Сведения.КоррСчет           = СвойствоСтрокой(Реквизиты, "КоррСчет");
		Сведения.БанкАдрес          = СвойствоСтрокой(Реквизиты, "АдресБанка");

		ЮрФизЛицо = Неопределено;
		Сведения.ЭтоИП = Реквизиты.Свойство("ЮридическоеФизическоеЛицо", ЮрФизЛицо)
			И ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо");

		// Краткое наименование вида ООО «Ромашка»: из сокращенного наименования или из полного.
		Сокращенное = СвойствоСтрокой(Реквизиты, "СокращенноеНаименование");
		ИзПолного = СокращеннаяФормаНаименования(Сведения.ПолноеНаименование);
		Если Сведения.ЭтоИП Тогда
			Сведения.ФИОИП = СвойствоСтрокой(Реквизиты, "ФИОФизлица");
			Если ПустаяСтрока(Сведения.ФИОИП) Тогда
				Сведения.ФИОИП = ФИОИзНаименованияИП(?(ПустаяСтрока(ИзПолного), Сокращенное, ИзПолного));
			КонецЕсли;
			Сведения.Наименование = "ИП " + Сведения.ФИОИП;
		ИначеЕсли ЕстьКавычки(Сокращенное) Тогда
			Сведения.Наименование = Сокращенное;
		ИначеЕсли ЕстьКавычки(ИзПолного) Тогда
			Сведения.Наименование = ИзПолного;
		ИначеЕсли Не ПустаяСтрока(Сокращенное) Тогда
			Сведения.Наименование = Сокращенное;
		Иначе
			Сведения.Наименование = СвойствоСтрокой(Реквизиты, "НаименованиеДляПечатныхФорм");
		КонецЕсли;
		Если ПустаяСтрока(Сведения.Наименование) Тогда
			Сведения.Наименование = Сведения.ПолноеНаименование;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(БанковскиеСчета.БанкДляРасчетов.Город, ЕСТЬNULL(БанковскиеСчета.Банк.Город, """")) КАК Город
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Ссылка = &Счет";
		Запрос.УстановитьПараметр("Счет", БанковскийСчет);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Сведения.БанкГород = СокрЛП(Выборка.Город);
			КонецЕсли;
		Исключение
			// Структура справочника отличается - город банка не заполняем.
		КонецПопытки;
	КонецЕсли;

	Сведения.Наименование       = КавычкиЕлочки(Сведения.Наименование);
	Сведения.ПолноеНаименование = КавычкиЕлочки(Сведения.ПолноеНаименование);
	Сведения.Банк               = КавычкиЕлочки(Сведения.Банк);

	Возврат Сведения;

КонецФункции

Функция НовыйРуководитель()

	// Пол: 1 - мужской, 2 - женский, Неопределено - не известен.
	// Откуда - где найден руководитель (для колонки «Откуда взято»).
	Возврат Новый Структура("ФИО, Должность, Пол, ФизическоеЛицо, Откуда", "", "", Неопределено, Неопределено, "");

КонецФункции

// Руководитель организации: карточка организации - «Ответственные лица» на дату платежки.
// Подписант из карточки договора - только если ответственные лица не заполнены.
//
Функция РуководительОрганизации(Организация, Дата, ДанныеДоговора)

	Руководитель = НовыйРуководитель();

	Если ЗначениеЗаполнено(Организация) Тогда
		Попытка
			Ответственные = ОтветственныеЛицаБП.ОтветственныеЛица(Организация, Дата);
			Руководитель.ФизическоеЛицо = Ответственные.Руководитель;
			Руководитель.Должность = Ответственные.РуководительДолжностьПредставление;
			ФИО = Ответственные.РуководительФИО;
			Если ТипЗнч(ФИО) = Тип("Структура") Тогда
				Руководитель.ФИО = СокрЛП(СтрШаблон("%1 %2 %3", ФИО.Фамилия, ФИО.Имя, ФИО.Отчество));
			Иначе
				Руководитель.ФИО = СокрЛП(ФИО);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Формирование документов по шаблону'"), УровеньЖурналаРегистрации.Предупреждение,,
				Организация, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если ПустаяСтрока(Руководитель.ФИО) И ЗначениеЗаполнено(Руководитель.ФизическоеЛицо) Тогда
			Руководитель.ФИО = ФИОФизическогоЛица(Руководитель.ФизическоеЛицо, Дата);
		КонецЕсли;
		Если Не ПустаяСтрока(Руководитель.ФИО) Тогда
			Руководитель.Откуда = НСтр("ru = 'Карточка организации: «Ответственные лица» (руководитель на дату платежки)'");
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Руководитель.ФИО) И ЗначениеЗаполнено(ДанныеДоговора.Руководитель) Тогда
		Руководитель.ФизическоеЛицо = ДанныеДоговора.Руководитель;
		Руководитель.ФИО = ФИОФизическогоЛица(ДанныеДоговора.Руководитель, Дата);
		Руководитель.Должность = Строка(ДанныеДоговора.ДолжностьРуководителя);
		Руководитель.Откуда = НСтр("ru = 'Карточка договора: подписант организации (ответственные лица организации не заполнены)'");
	КонецЕсли;

	Если ЗначениеЗаполнено(Руководитель.ФизическоеЛицо) Тогда
		Попытка
			Пол = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Руководитель.ФизическоеЛицо, "Пол");
			Если Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский") Тогда
				Руководитель.Пол = 2;
			ИначеЕсли Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской") Тогда
				Руководитель.Пол = 1;
			КонецЕсли;
		Исключение
			// Пол определим по отчеству.
		КонецПопытки;
	КонецЕсли;

	Возврат Руководитель;

КонецФункции

// Руководитель контрагента: карточка контрагента - «Контактные лица» с должностью директора/руководителя
// (в типовой карточке контрагента отдельного поля «Руководитель» нет).
// Подписант из карточки договора - только если подходящего контактного лица нет.
//
Функция РуководительКонтрагента(Контрагент, ДанныеДоговора)

	Руководитель = НовыйРуководитель();

	Если ЗначениеЗаполнено(Контрагент) И Контрагент.Метаданные().Имя = "Контрагенты" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтактныеЛица.Фамилия КАК Фамилия,
		|	КонтактныеЛица.Имя КАК Имя,
		|	КонтактныеЛица.Отчество КАК Отчество,
		|	КонтактныеЛица.Наименование КАК Наименование,
		|	КонтактныеЛица.Должность КАК Должность
		|ИЗ
		|	Справочник.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.ОбъектВладелец = &Контрагент
		|	И НЕ КонтактныеЛица.ПометкаУдаления
		|	И (КонтактныеЛица.Должность ПОДОБНО ""%директор%""
		|			ИЛИ КонтактныеЛица.Должность ПОДОБНО ""%руководител%""
		|			ИЛИ КонтактныеЛица.Должность ПОДОБНО ""%президент%"")
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА КонтактныеЛица.Ссылка = КонтактныеЛица.ОбъектВладелец.ОсновноеКонтактноеЛицо
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА КонтактныеЛица.Должность ПОДОБНО ""%генеральн%""
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ";
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Руководитель.ФИО = СокрЛП(СтрШаблон("%1 %2 %3", Выборка.Фамилия, Выборка.Имя, Выборка.Отчество));
				Если ПустаяСтрока(Руководитель.ФИО) Тогда
					// В наименовании контактного лица иногда через запятую указана должность.
					Руководитель.ФИО = СокрЛП(СтрРазделить(Выборка.Наименование, ",")[0]);
				КонецЕсли;
				Руководитель.Должность = СокрЛП(Выборка.Должность);
				Руководитель.Откуда = СтрШаблон(НСтр("ru = 'Карточка контрагента: «Контактные лица» (%1, %2)'"),
					Руководитель.ФИО, Руководитель.Должность);
			КонецЕсли;
		Исключение
			// Справочник контактных лиц отличается - ищем в договоре.
		КонецПопытки;
	КонецЕсли;

	Если ПустаяСтрока(Руководитель.ФИО) И ЗначениеЗаполнено(ДанныеДоговора.РуководительКонтрагента) Тогда
		Руководитель.ФИО = СокрЛП(ДанныеДоговора.РуководительКонтрагента);
		Руководитель.Должность = СокрЛП(ДанныеДоговора.ДолжностьРуководителяКонтрагента);
		Руководитель.Откуда = НСтр("ru = 'Карточка договора: руководитель контрагента (в контактных лицах контрагента руководителя нет)'");
		Попытка
			Если ДанныеДоговора.ПолРуководителяКонтрагента = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский") Тогда
				Руководитель.Пол = 2;
			ИначеЕсли ДанныеДоговора.ПолРуководителяКонтрагента = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской") Тогда
				Руководитель.Пол = 1;
			КонецЕсли;
		Исключение
			// Пол определим по отчеству.
		КонецПопытки;
	КонецЕсли;

	Возврат Руководитель;

КонецФункции

Процедура ДобавитьДанныеРуководителя(Данные, Префикс, Сведения, Руководитель)

	ЭтоОрганизация = (Префикс = "Организация");
	Если ЭтоОрганизация Тогда
		ГдеЗаполнить = НСтр("ru = 'Справочники - Организации - карточка организации, раздел «Ответственные лица»: руководитель и должность'");
	Иначе
		ГдеЗаполнить = НСтр("ru = 'Справочники - Контрагенты - карточка контрагента, раздел «Контактные лица»: добавьте руководителя (Фамилия, Имя, Отчество) и укажите должность, например «Генеральный директор»'");
	КонецЕсли;

	ОснованиеПолномочий = "Устава";
	ОткудаОснование = НСтр("ru = 'Стандартное значение (для юридического лица - «Устава»)'");
	Если Сведения.ЭтоИП Тогда
		// Индивидуальный предприниматель подписывает сам.
		Руководитель.ФИО = Сведения.ФИОИП;
		Руководитель.Должность = НСтр("ru = 'Индивидуальный предприниматель'");
		Руководитель.Откуда = ?(ЭтоОрганизация, НСтр("ru = 'Карточка организации'"), НСтр("ru = 'Карточка контрагента'"))
			+ НСтр("ru = ': индивидуальный предприниматель подписывает сам'");
		ОснованиеПолномочий = НСтр("ru = 'листа записи ЕГРИП'");
		ОткудаОснование = НСтр("ru = 'Стандартное значение для индивидуального предпринимателя'");
	КонецЕсли;

	ФИО = СокрЛП(Руководитель.ФИО);
	Должность = НРег(СокрЛП(Руководитель.Должность));
	Пол = Руководитель.Пол;
	ОткудаПол = НСтр("ru = 'По полу руководителя (карточка физического лица)'");
	Если Пол = Неопределено Тогда
		Пол = ПолПоФИО(ФИО);
		ОткудаПол = НСтр("ru = 'По полу руководителя (определен по отчеству)'");
	КонецЕсли;

	ЧастиФИО = СтрРазделить(ФИО, " ", Ложь);
	ИнициалыФамилия = ФИО;
	ФамилияИнициалы = ФИО;
	Если ЧастиФИО.Количество() >= 2 Тогда
		Инициалы = "";
		Для Индекс = 1 По ЧастиФИО.ВГраница() Цикл
			Инициалы = Инициалы + Лев(ЧастиФИО[Индекс], 1) + ".";
		КонецЦикла;
		ИнициалыФамилия = Инициалы + " " + ЧастиФИО[0];
		ФамилияИнициалы = ЧастиФИО[0] + " " + Инициалы;
	КонецЕсли;

	Откуда = Руководитель.Откуда;
	Склонение = НСтр("ru = ' - склонено автоматически'");
	УстановитьПоле(Данные, Префикс + ".РуководительФИО", ФИО, Откуда, ГдеЗаполнить);
	УстановитьПоле(Данные, Префикс + ".РуководительФИОРП", ПросклонятьФИО(ФИО, 2, Пол), Откуда + Склонение, ГдеЗаполнить);
	УстановитьПоле(Данные, Префикс + ".РуководительИнициалыФамилия", ИнициалыФамилия, Откуда, ГдеЗаполнить);
	УстановитьПоле(Данные, Префикс + ".РуководительФамилияИнициалы", ФамилияИнициалы, Откуда, ГдеЗаполнить);
	УстановитьПоле(Данные, Префикс + ".РуководительДолжность", ПерваяБукваЗаглавная(Должность), Откуда, ГдеЗаполнить);
	УстановитьПоле(Данные, Префикс + ".РуководительДолжностьРП", ПерваяБукваСтрочная(ПросклонятьСтроку(Должность, 2)),
		Откуда + Склонение, ГдеЗаполнить);
	Если ПустаяСтрока(ФИО) Тогда
		УстановитьПоле(Данные, Префикс + ".Действующего", "", ОткудаПол, ГдеЗаполнить);
	Иначе
		УстановитьПоле(Данные, Префикс + ".Действующего", ?(Пол = 2, "действующей", "действующего"), ОткудаПол, ГдеЗаполнить);
	КонецЕсли;
	УстановитьПоле(Данные, Префикс + ".ОснованиеПолномочий", ОснованиеПолномочий, ОткудаОснование);

КонецПроцедуры

Функция ФИОФизическогоЛица(ФизическоеЛицо, Дата)

	Попытка
		ДанныеФИО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФизическоеЛицо, "ФИО, Фамилия, Имя, Отчество");
		Если ЗначениеЗаполнено(ДанныеФИО.Фамилия) Тогда
			Возврат СокрЛП(СтрШаблон("%1 %2 %3", ДанныеФИО.Фамилия, ДанныеФИО.Имя, ДанныеФИО.Отчество));
		КонецЕсли;
		Возврат СокрЛП(ДанныеФИО.ФИО);
	Исключение
		Возврат СокрЛП(Строка(ФизическоеЛицо));
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ЗапомненныеЗначения

// Ключ владельца запомненного значения поля: контрагент, организация или шаблон.
//
Функция КлючВладельцаПоля(Имя, Шаблон, Данные)

	Если СтрНачинаетсяС(Имя, "Контрагент.") Тогда
		Владелец = Данные["Служебное.Контрагент"];
	ИначеЕсли СтрНачинаетсяС(Имя, "Организация.") Тогда
		Владелец = Данные["Служебное.Организация"];
	Иначе
		Владелец = Шаблон;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Владелец.Метаданные().Имя + ":" + Строка(Владелец.УникальныйИдентификатор());

КонецФункции

// Запомненные исправления. Исправление применяется, только пока программа рассчитывает то же исходное
// значение, которое пользователь исправлял. Если данные в карточке изменятся (например, сменится
// руководитель или заполнят ОКПО), подставятся новые данные из карточки.
//
Функция ЗапомненныеЗначения(Шаблон, Данные)

	Ключи = Новый Массив;
	Ключи.Добавить(КлючВладельцаПоля("Контрагент.", Шаблон, Данные));
	Ключи.Добавить(КлючВладельцаПоля("Организация.", Шаблон, Данные));
	Ключи.Добавить(КлючВладельцаПоля("", Шаблон, Данные));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запомненные.Владелец КАК Владелец,
	|	Запомненные.ИмяПоля КАК ИмяПоля,
	|	Запомненные.Значение КАК Значение,
	|	Запомненные.ИсходноеЗначение КАК ИсходноеЗначение
	|ИЗ
	|	РегистрСведений.ШД_ЗапомненныеЗначения КАК Запомненные
	|ГДЕ
	|	Запомненные.Владелец В(&Ключи)";
	Запрос.УстановитьПараметр("Ключи", Ключи);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Владелец + "#" + Выборка.ИмяПоля,
			Новый Структура("Значение, ИсходноеЗначение", Выборка.Значение, Выборка.ИсходноеЗначение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЗаполнениеDOCX

Функция ЗаполнитьШаблонDOCX(ДвоичныеДанные, Значения)

	КаталогРаспаковки = РаспаковатьDOCX(ДвоичныеДанные);
	ИмяРезультата = ПолучитьИмяВременногоФайла("docx");

	Попытка

		Для Каждого ИмяЧасти Из ЧастиДокументаСТекстом(КаталогРаспаковки) Цикл
			Текст = ПрочитатьТекстФайла(ИмяЧасти);
			НовыйТекст = ЗаполнитьXML(ОбъединитьРазорванныеПоля(Текст), Значения);
			Если НовыйТекст <> Текст Тогда
				ЗаписатьТекстФайла(ИмяЧасти, НовыйТекст);
			КонецЕсли;
		КонецЦикла;

		Архив = Новый ЗаписьZipФайла(ИмяРезультата);
		Архив.Добавить(КаталогРаспаковки + ПолучитьРазделительПути() + "*",
			РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
			РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		Архив.Записать();

		Результат = Новый ДвоичныеДанные(ИмяРезультата);

	Исключение
		УдалитьВременныйКаталог(КаталогРаспаковки);
		УдалитьВременныйКаталог(ИмяРезультата);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременныйКаталог(КаталогРаспаковки);
	УдалитьВременныйКаталог(ИмяРезультата);

	Возврат Результат;

КонецФункции

Функция РаспаковатьDOCX(ДвоичныеДанные)

	ПроверитьБезопасныйРежим();

	ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
	ДвоичныеДанные.Записать(ИмяАрхива);

	Каталог = ПолучитьИмяВременногоФайла("");
	СоздатьКаталог(Каталог);

	Попытка
		Архив = Новый ЧтениеZipФайла(ИмяАрхива);
		Архив.ИзвлечьВсе(Каталог, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		Архив.Закрыть();
	Исключение
		УдалитьВременныйКаталог(ИмяАрхива);
		УдалитьВременныйКаталог(Каталог);
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Файл шаблона не является документом Word (.docx): %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УдалитьВременныйКаталог(ИмяАрхива);

	Возврат Каталог;

КонецФункции

// Файл Word (.docx) - это ZIP-архив, для его заполнения нужны временные файлы на сервере.
// В безопасном режиме платформа запрещает работу с файлами, поэтому сообщаем, как это исправить.
//
Процедура ПроверитьБезопасныйРежим()

	Если БезопасныйРежим() = Ложь Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение НСтр("ru = 'Расширение «Формирование документов по шаблону» подключено в безопасном режиме, в котором невозможно сформировать файл Word.
		|Администратору нужно открыть: Администрирование - Печатные формы, отчеты и обработки - Расширения,
		|выбрать расширение «Формирование документов по шаблону», снять флажок «Безопасный режим» и перезапустить программу.'");

КонецПроцедуры

// Файлы документа Word, в которых может быть текст с полями: тело, колонтитулы, сноски.
//
Функция ЧастиДокументаСТекстом(Каталог)

	Результат = Новый Массив;
	КаталогWord = Каталог + ПолучитьРазделительПути() + "word";
	Для Каждого Файл Из НайтиФайлы(КаталогWord, "*.xml", Ложь) Цикл
		ИмяФайла = НРег(Файл.Имя);
		Если ИмяФайла = "document.xml"
			Или СтрНачинаетсяС(ИмяФайла, "header")
			Или СтрНачинаетсяС(ИмяФайла, "footer")
			Или ИмяФайла = "footnotes.xml"
			Или ИмяФайла = "endnotes.xml" Тогда
			Результат.Добавить(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьТекстФайла(ИмяФайла)

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(ИмяФайла), КодировкаТекста.UTF8);

КонецФункции

Процедура ЗаписатьТекстФайла(ИмяФайла, Текст)

	// Без BOM: части документа Word записываются в чистом UTF-8.
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(ИмяФайла);

КонецПроцедуры

Процедура УдалитьВременныйКаталог(Путь)

	Попытка
		УдалитьФайлы(Путь);
	Исключение
		// Временный файл будет удален платформой позже.
	КонецПопытки;

КонецПроцедуры

// Word часто разбивает набранный текст на несколько фрагментов (w:r) с разной разметкой,
// и поле {{Имя}} оказывается разорвано XML-тегами. Функция удаляет теги внутри поля,
// чтобы оно стало сплошным текстом внутри первого фрагмента. Поля, разорванные абзацем, не трогаются.
//
Функция ОбъединитьРазорванныеПоля(Текст)

	Части = Новый Массив;
	Позиция = 1;
	ДлинаТекста = СтрДлина(Текст);

	Пока Позиция <= ДлинаТекста Цикл

		Начало = НайтиСПозиции(Текст, "{", Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Конец = КонецРазорванногоПоля(Текст, Начало, ДлинаТекста);
		Если Конец = 0 Тогда
			Части.Добавить(Сред(Текст, Позиция, Начало - Позиция + 1));
			Позиция = Начало + 1;
			Продолжить;
		КонецЕсли;

		Части.Добавить(Сред(Текст, Позиция, Начало - Позиция));
		Части.Добавить(ТекстБезТегов(Сред(Текст, Начало, Конец - Начало + 1)));
		Позиция = Конец + 1;

	КонецЦикла;

	Если Позиция <= ДлинаТекста Тогда
		Части.Добавить(Сред(Текст, Позиция));
	КонецЕсли;

	Возврат СтрСоединить(Части);

КонецФункции

// Возвращает позицию последней «}» поля, начинающегося с «{» в позиции Начало,
// с учетом того, что между символами поля могут стоять XML-теги. 0 - если это не поле.
//
Функция КонецРазорванногоПоля(Текст, Начало, ДлинаТекста)

	МаксимумСимволовПоля = 300;

	// Символ «{» не должен находиться внутри тега.
	ПоследнееОткрытие = СтрНайти(Текст, "<", НаправлениеПоиска.СКонца, Начало);
	ПоследнееЗакрытие = СтрНайти(Текст, ">", НаправлениеПоиска.СКонца, Начало);
	Если ПоследнееОткрытие > ПоследнееЗакрытие Тогда
		Возврат 0;
	КонецЕсли;

	ПредыдущийСимвол = "{";
	Позиция = Начало + 1;
	СимволовТекста = 1;
	ВторойСимволПроверен = Ложь;

	Пока Позиция <= ДлинаТекста И СимволовТекста <= МаксимумСимволовПоля Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Символ = "<" Тогда
			КонецТега = НайтиСПозиции(Текст, ">", Позиция);
			Если КонецТега = 0 Тогда
				Возврат 0;
			КонецЕсли;
			Тег = Сред(Текст, Позиция, КонецТега - Позиция + 1);
			Если СтрНачинаетсяС(Тег, "</w:p>") Или СтрНачинаетсяС(Тег, "<w:p ") Или Тег = "<w:p>"
				Или СтрНачинаетсяС(Тег, "<w:tab") Или СтрНачинаетсяС(Тег, "<w:br") Тогда
				Возврат 0;
			КонецЕсли;
			Позиция = КонецТега + 1;
			Продолжить;
		КонецЕсли;

		СимволовТекста = СимволовТекста + 1;

		Если Не ВторойСимволПроверен Тогда
			Если Символ <> "{" Тогда
				Возврат 0;
			КонецЕсли;
			ВторойСимволПроверен = Истина;
		ИначеЕсли Символ = "}" И ПредыдущийСимвол = "}" Тогда
			Возврат Позиция;
		ИначеЕсли Символ = "{" Тогда
			Возврат 0;
		КонецЕсли;

		ПредыдущийСимвол = Символ;
		Позиция = Позиция + 1;

	КонецЦикла;

	Возврат 0;

КонецФункции

Функция НайтиСПозиции(Текст, Подстрока, НачальнаяПозиция)

	Если НачальнаяПозиция > СтрДлина(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат СтрНайти(Текст, Подстрока, , НачальнаяПозиция);

КонецФункции

Функция ТекстБезТегов(Фрагмент)

	Если СтрНайти(Фрагмент, "<") = 0 Тогда
		Возврат Фрагмент;
	КонецЕсли;

	Части = Новый Массив;
	Позиция = 1;
	Пока Истина Цикл
		НачалоТега = НайтиСПозиции(Фрагмент, "<", Позиция);
		Если НачалоТега = 0 Тогда
			Части.Добавить(Сред(Фрагмент, Позиция));
			Прервать;
		КонецЕсли;
		Части.Добавить(Сред(Фрагмент, Позиция, НачалоТега - Позиция));
		Позиция = НайтиСПозиции(Фрагмент, ">", НачалоТега) + 1;
	КонецЦикла;

	Возврат СтрСоединить(Части);

КонецФункции

// Выражения полей (содержимое между {{ и }}) в порядке появления.
//
Функция ВыраженияПолей(Текст)

	Результат = Новый Массив;
	Позиция = 1;
	Пока Истина Цикл
		Начало = НайтиСПозиции(Текст, "{{", Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = НайтиСПозиции(Текст, "}}", Начало + 2);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Выражение = Сред(Текст, Начало + 2, Конец - Начало - 2);
		Если СтрНайти(Выражение, "{") = 0 И СтрНайти(Выражение, "<") = 0 Тогда
			Результат.Добавить(Выражение);
		КонецЕсли;
		Позиция = Конец + 2;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИмяПоляВыражения(Выражение)

	Возврат СокрЛП(СтрРазделить(Выражение, "|", Истина)[0]);

КонецФункции

// Заменяет поля в XML части документа значениями (с экранированием XML).
//
Функция ЗаполнитьXML(Текст, Значения)

	Возврат ЗаполнитьСтроку(Текст, Значения, Истина);

КонецФункции

// Заменяет поля {{...}} в строке значениями.
//
// Параметры:
//  Текст    - Строка
//  Значения - Соответствие - имя поля -> значение (строка или типизированное значение).
//  ДляXML   - Булево - экранировать значения для XML документа Word.
//
Функция ЗаполнитьСтроку(Текст, Значения, ДляXML = Ложь)

	Части = Новый Массив;
	Позиция = 1;
	Пока Истина Цикл

		Начало = НайтиСПозиции(Текст, "{{", Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = НайтиСПозиции(Текст, "}}", Начало + 2);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;

		Выражение = Сред(Текст, Начало + 2, Конец - Начало - 2);
		Если СтрНайти(Выражение, "{") > 0 Или СтрНайти(Выражение, "<") > 0 Тогда
			Части.Добавить(Сред(Текст, Позиция, Начало - Позиция + 2));
			Позиция = Начало + 2;
			Продолжить;
		КонецЕсли;

		Если ДляXML Тогда
			// В XML символы выражения могут быть экранированы (например, &quot;).
			Выражение = СтрЗаменить(Выражение, "&quot;", """");
			Выражение = СтрЗаменить(Выражение, "&apos;", "'");
			Выражение = СтрЗаменить(Выражение, "&amp;", "&");
		КонецЕсли;

		Значение = ЗначениеВыражения(Выражение, Значения);
		Если ДляXML Тогда
			Значение = ЗначениеДляXML(Значение);
		КонецЕсли;

		Части.Добавить(Сред(Текст, Позиция, Начало - Позиция));
		Части.Добавить(Значение);
		Позиция = Конец + 2;

	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));

	Возврат СтрСоединить(Части);

КонецФункции

Функция ЗначениеВыражения(Выражение, Значения)

	Части = СтрРазделить(Выражение, "|", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Имя = СокрЛП(Части[0]);
	Значение = Значения[Имя];
	Для Индекс = 1 По Части.ВГраница() Цикл
		Значение = ПрименитьМодификатор(Значение, СокрЛП(Части[Индекс]), Имя);
	КонецЦикла;

	Возврат ПредставлениеЗначения(Значение);

КонецФункции

Функция ЗначениеДляXML(Знач Значение)

	Значение = СтрЗаменить(Значение, "&", "&amp;");
	Значение = СтрЗаменить(Значение, "<", "&lt;");
	Значение = СтрЗаменить(Значение, ">", "&gt;");
	Значение = СтрЗаменить(Значение, Символы.ВК + Символы.ПС, Символы.ПС);
	// Перенос строки внутри значения - разрыв строки Word.
	Значение = СтрЗаменить(Значение, Символы.ПС, "</w:t><w:br/><w:t xml:space=""preserve"">");

	Возврат Значение;

КонецФункции

#КонецОбласти

#Область ФорматированиеЗначений

Функция ПредставлениеЗначения(Значение) Экспорт

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДЛФ=ДД"), "");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'"));
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ПрименитьМодификатор(Значение, Модификатор, ИмяПоля = "")

	МодификаторВРег = ВРег(Модификатор);

	Если МодификаторВРег = "ВРЕГ" Тогда
		Возврат ВРег(ПредставлениеЗначения(Значение));
	ИначеЕсли МодификаторВРег = "НРЕГ" Тогда
		Возврат НРег(ПредставлениеЗначения(Значение));
	ИначеЕсли МодификаторВРег = "ТРЕГ" Тогда
		Возврат ТРег(ПредставлениеЗначения(Значение));
	ИначеЕсли МодификаторВРег = "ПЕРВАЯВРЕГ" Тогда
		Возврат ПерваяБукваЗаглавная(ПредставлениеЗначения(Значение));
	ИначеЕсли МодификаторВРег = "ПЕРВАЯНРЕГ" Тогда
		Возврат ПерваяБукваСтрочная(ПредставлениеЗначения(Значение));
	ИначеЕсли СтрНачинаетсяС(МодификаторВРег, "ПОДПИСЬ:") Тогда
		// Подпись выводится только вместе с заполненным значением: {{Контрагент.ОКПО|ПОДПИСЬ:ОКПО}} -> «ОКПО 12345» или пусто.
		Строка = СокрЛП(ПредставлениеЗначения(Значение));
		Возврат ?(ПустаяСтрока(Строка), "", СокрЛП(Сред(Модификатор, 9)) + " " + Строка);
	ИначеЕсли МодификаторВРег = "НОВАЯСТРОКА" Тогда
		// Перенос строки перед значением, только если оно заполнено.
		Строка = ПредставлениеЗначения(Значение);
		Возврат ?(ПустаяСтрока(Строка), "", Символы.ПС + Строка);
	ИначеЕсли МодификаторВРег = "ПРОПИСЬЮ" Тогда
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат ЧислоПрописьюБезЕдиниц(Значение);
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Падеж = СтрРазделить("РП,ДП,ВП,ТП,ПП", ",").Найти(МодификаторВРег);
	Если Падеж <> Неопределено Тогда
		Падеж = Падеж + 2; // 2 - родительный ... 6 - предложный
		Строка = ПредставлениеЗначения(Значение);
		Если СтрНайти(ВРег(ИмяПоля), "ФИО") > 0 Тогда
			Возврат ПросклонятьФИО(Строка, Падеж, ПолПоФИО(Строка));
		КонецЕсли;
		Возврат ПросклонятьСтроку(Строка, Падеж);
	КонецЕсли;

	// Сдвиг даты: +4Г, -1М, +10Д
	Если ТипЗнч(Значение) = Тип("Дата") И СтрДлина(МодификаторВРег) >= 3
		И (Лев(МодификаторВРег, 1) = "+" Или Лев(МодификаторВРег, 1) = "-") Тогда
		Единица = Прав(МодификаторВРег, 1);
		Попытка
			Количество = Число(Сред(МодификаторВРег, 2, СтрДлина(МодификаторВРег) - 2));
		Исключение
			Возврат Значение;
		КонецПопытки;
		Если Лев(МодификаторВРег, 1) = "-" Тогда
			Количество = -Количество;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		ИначеЕсли Единица = "Г" Тогда
			Возврат ДобавитьМесяц(Значение, 12 * Количество);
		ИначеЕсли Единица = "М" Тогда
			Возврат ДобавитьМесяц(Значение, Количество);
		ИначеЕсли Единица = "Д" Тогда
			Возврат Значение + 86400 * Количество;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	// Форматная строка 1С
	Если СтрНайти(Модификатор, "=") > 0 Тогда
		Если ТипЗнч(Значение) = Тип("Дата") Тогда
			Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, Модификатор), "");
		ИначеЕсли ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат Формат(Значение, Модификатор);
		КонецЕсли;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ЧислоПрописьюБезЕдиниц(Знач Число)

	Число = Цел(Число);
	Попытка
		Текст = ЧислоПрописью(Число, "L=ru_RU; НП=Ложь", ",,,м,,,,,0");
	Исключение
		Текст = ЧислоПрописью(Число, "L=ru_RU", ",,,м,,,,,0");
	КонецПопытки;
	Текст = НРег(СокрЛП(Текст));

	Возврат Текст;

КонецФункции

Функция ФормаСловаПоЧислу(Число, Форма1, Форма2, Форма5)

	Остаток100 = Цел(Число) % 100;
	Остаток10 = Цел(Число) % 10;
	Если Остаток100 >= 11 И Остаток100 <= 14 Тогда
		Возврат Форма5;
	ИначеЕсли Остаток10 = 1 Тогда
		Возврат Форма1;
	ИначеЕсли Остаток10 >= 2 И Остаток10 <= 4 Тогда
		Возврат Форма2;
	КонецЕсли;

	Возврат Форма5;

КонецФункции

// Заменяет прямые кавычки на «елочки»: ООО "Ромашка" -> ООО «Ромашка».
//
Функция КавычкиЕлочки(Знач Строка)

	Если СтрНайти(Строка, """") = 0 Тогда
		Возврат Строка;
	КонецЕсли;

	Результат = "";
	Открыта = Ложь;
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ = """" Тогда
			// Открывающая - в начале или после пробела/открывающей кавычки.
			Предыдущий = ?(Индекс > 1, Сред(Строка, Индекс - 1, 1), " ");
			Если Не Открыта Или Предыдущий = " " Или Предыдущий = "«" Тогда
				Символ = "«";
				Открыта = Истина;
			Иначе
				Символ = "»";
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ "РОМАШКА" -> ООО "РОМАШКА"
//
Функция СокращеннаяФормаНаименования(Знач Наименование)

	Наименование = СокрЛП(Наименование);
	Формы = Новый Массив;
	Формы.Добавить("ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ|ООО");
	Формы.Добавить("ПУБЛИЧНОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО|ПАО");
	Формы.Добавить("НЕПУБЛИЧНОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО|АО");
	Формы.Добавить("ЗАКРЫТОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО|ЗАО");
	Формы.Добавить("ОТКРЫТОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО|ОАО");
	Формы.Добавить("АКЦИОНЕРНОЕ ОБЩЕСТВО|АО");
	Формы.Добавить("ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ|ИП");

	Для Каждого Форма Из Формы Цикл
		Части = СтрРазделить(Форма, "|");
		Если СтрНачинаетсяС(ВРег(Наименование), Части[0]) Тогда
			Возврат Части[1] + Сред(Наименование, СтрДлина(Части[0]) + 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Наименование;

КонецФункции

Функция ФИОИзНаименованияИП(Знач Наименование)

	Наименование = СокрЛП(Наименование);
	Если СтрНачинаетсяС(ВРег(Наименование), "ИП ") Тогда
		Наименование = СокрЛП(Сред(Наименование, 4));
	ИначеЕсли СтрЗаканчиваетсяНа(ВРег(Наименование), " ИП") Тогда
		Наименование = СокрЛП(Лев(Наименование, СтрДлина(Наименование) - 3));
	КонецЕсли;

	Возврат Наименование;

КонецФункции

Функция ЕстьКавычки(Строка)

	Возврат СтрНайти(Строка, """") > 0 Или СтрНайти(Строка, "«") > 0;

КонецФункции

Функция ПерваяБукваЗаглавная(Строка)

	Возврат ВРег(Лев(Строка, 1)) + Сред(Строка, 2);

КонецФункции

Функция ПерваяБукваСтрочная(Строка)

	Возврат НРег(Лев(Строка, 1)) + Сред(Строка, 2);

КонецФункции

// Пол по отчеству: 1 - мужской, 2 - женский, Неопределено - не удалось определить.
//
Функция ПолПоФИО(ФИО)

	Части = СтрРазделить(ФИО, " ", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Отчество = НРег(Части[2]);
	Если СтрЗаканчиваетсяНа(Отчество, "вна") Или СтрЗаканчиваетсяНа(Отчество, "чна") Или СтрЗаканчиваетсяНа(Отчество, "кызы") Тогда
		Возврат 2;
	ИначеЕсли СтрЗаканчиваетсяНа(Отчество, "вич") Или СтрЗаканчиваетсяНа(Отчество, "ич") Или СтрЗаканчиваетсяНа(Отчество, "оглы") Тогда
		Возврат 1;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПросклонятьФИО(ФИО, Падеж, Пол)

	Если ПустаяСтрока(ФИО) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Результат = СклонениеПредставленийОбъектов.ПросклонятьФИО(ФИО, Падеж, , Пол);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Формирование документов по шаблону'"), УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ФИО;

КонецФункции

Функция ПросклонятьСтроку(Строка, Падеж)

	Если ПустаяСтрока(Строка) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Результат = СклонениеПредставленийОбъектов.ПросклонятьПредставление(Строка, Падеж);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Формирование документов по шаблону'"), УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Строка;

КонецФункции

Функция СвойствоСтрокой(Структура, ИмяСвойства)

	Значение = Неопределено;
	Если Не Структура.Свойство(ИмяСвойства, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция БезопасноеИмяФайла(Знач Имя)

	Для Каждого Символ Из СтрРазделить("\ / : * ? "" < > |", " ") Цикл
		Имя = СтрЗаменить(Имя, Символ, "-");
	КонецЦикла;
	Имя = СтрЗаменить(Имя, "«", "");
	Имя = СтрЗаменить(Имя, "»", "");
	Имя = СокрЛП(СтрЗаменить(Имя, Символы.ПС, " "));

	Если ПустаяСтрока(Имя) Тогда
		Имя = НСтр("ru = 'Документ'");
	КонецЕсли;

	Возврат Лев(Имя, 150);

КонецФункции


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Документ = Параметры.Документ;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗапомнитьИсправления = Истина;

	ШД_ФормированиеДокументов.ОбновитьПоставляемыеШаблоны();
	Шаблон = ШаблонПоУмолчанию();
	ЗаполнитьПоля();

	НастроитьОформление();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_ШД_ШаблоныДокументов" Тогда
		ОбработкаОповещенияНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ШаблонПриИзменении(Элемент)

	ЗаполнитьПоля();

КонецПроцедуры

&НаКлиенте
Процедура ПоляПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Поля.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные.Изменено = ?(ТекущиеДанные.Значение = ТекущиеДанные.АвтоЗначение, 0, 1);
	Если ТекущиеДанные.Значение = ТекущиеДанные.АвтоЗначение Тогда
		ТекущиеДанные.Статус = ТекущиеДанные.АвтоСтатус;
		ТекущиеДанные.Пояснение = ТекущиеДанные.АвтоПояснение;
		ТекущиеДанные.Источник = ТекущиеДанные.АвтоИсточник;
	ИначеЕсли ПустаяСтрока(ТекущиеДанные.Значение) Тогда
		ТекущиеДанные.Источник = НСтр("ru = 'Очищено вручную'");
		ТекущиеДанные.Статус = "Пусто";
		ТекущиеДанные.Пояснение = НСтр("ru = 'Не заполнено - впишите значение'");
	Иначе
		// Пользователь проверил и исправил значение - выделение снимаем.
		ТекущиеДанные.Статус = "";
		ТекущиеДанные.Пояснение = НСтр("ru = 'Исправлено вручную'");
		ТекущиеДанные.Источник = НСтр("ru = 'Введено вручную'");
	КонецЕсли;
	ОбновитьИтогПроверки(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)

	Результат = СформироватьНаСервере();
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ФайловаяСистемаКлиент.ОткрытьФайл(Результат.Адрес, , Результат.ИмяФайла);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьКак(Команда)

	Результат = СформироватьНаСервере();
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Результат.Адрес, Результат.ИмяФайла);

КонецПроцедуры

&НаКлиенте
Процедура НастроитьШаблоны(Команда)

	ОткрытьФорму("Справочник.ШД_ШаблоныДокументов.ФормаСписка", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОрганизацию(Команда)
	
	ОткрытьКарточку("Организация");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКонтрагента(Команда)
	
	ОткрытьКарточку("Контрагент");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДоговор(Команда)
	
	ОткрытьКарточку("Договор");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанные(Команда)
	
	ОбновитьДанныеНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Данные обновлены'"), , НСтр("ru = 'Значения перечитаны из платежки и карточек. Ваши ручные исправления сохранены.'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьАвтозначение(Команда)

	ТекущиеДанные = Элементы.Поля.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Значение = ТекущиеДанные.АвтоЗначение;
		ТекущиеДанные.Изменено = 0;
		ТекущиеДанные.Статус = ТекущиеДанные.АвтоСтатус;
		ТекущиеДанные.Пояснение = ТекущиеДанные.АвтоПояснение;
		ТекущиеДанные.Источник = ТекущиеДанные.АвтоИсточник;
		ОбновитьИтогПроверки(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьКарточку(Вид)
	
	Ссылки = СсылкиНаКарточки(Документ);
	Ссылка = Ссылки[Вид];
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Если Вид = "Договор" Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'В платежном поручении не выбран договор.'"));
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'В платежном поручении не заполнено это поле.'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, Ссылка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СсылкиНаКарточки(Документ)
	
	Возврат ШД_ФормированиеДокументов.СсылкиНаКарточки(Документ);
	
КонецФункции

// Перечитывает данные. Значения, исправленные вручную в этом окне, сохраняются,
// если из 1С по-прежнему приходит то же исходное значение (например, карточку не меняли).
//
&НаСервере
Процедура ОбновитьДанныеНаСервере()
	
	Исправления = Новый Соответствие;
	Для Каждого СтрокаПоля Из Поля Цикл
		Если СтрокаПоля.Изменено = 1 Тогда
			Исправления.Вставить(СтрокаПоля.Имя, Новый Структура("Значение, АвтоЗначение", СтрокаПоля.Значение, СтрокаПоля.АвтоЗначение));
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьПоля();
	
	Для Каждого СтрокаПоля Из Поля Цикл
		Исправление = Исправления[СтрокаПоля.Имя];
		Если Исправление <> Неопределено И Исправление.АвтоЗначение = СтрокаПоля.АвтоЗначение Тогда
			СтрокаПоля.Значение = Исправление.Значение;
			СтрокаПоля.Изменено = 1;
			СтрокаПоля.Статус = ?(ПустаяСтрока(СтрокаПоля.Значение), "Пусто", "");
			СтрокаПоля.Пояснение = НСтр("ru = 'Исправлено вручную'");
			СтрокаПоля.Источник = НСтр("ru = 'Введено вручную'");
		КонецЕсли;
	КонецЦикла;
	ОбновитьИтогПроверки(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоля()

	Поля.Очистить();
	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Поле Из ШД_ФормированиеДокументов.ПоляШаблонаДляДокумента(Шаблон, Документ) Цикл
		СтрокаПоля = Поля.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоля, Поле);
		СтрокаПоля.Изменено = ?(СтрокаПоля.Значение = СтрокаПоля.АвтоЗначение, 0, 1);
	КонецЦикла;

	ОбновитьИтогПроверки(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере()

	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Выберите документ (шаблон), который нужно сформировать.'"), , "Шаблон");
		Возврат Неопределено;
	КонецЕсли;

	МассивПолей = Новый Массив;
	НеЗаполнены = Новый Массив;
	Для Каждого СтрокаПоля Из Поля Цикл
		Поле = Новый Структура("Имя, Представление, Значение, АвтоЗначение, Запоминать");
		ЗаполнитьЗначенияСвойств(Поле, СтрокаПоля);
		МассивПолей.Добавить(Поле);
		Если ПустаяСтрока(СтрокаПоля.Значение) Тогда
			НеЗаполнены.Добавить(СтрокаПоля.Представление);
		КонецЕсли;
	КонецЦикла;

	Результат = ШД_ФормированиеДокументов.СформироватьДокумент(Шаблон, Документ, МассивПолей);

	Если ЗапомнитьИсправления Тогда
		ШД_ФормированиеДокументов.ЗапомнитьИсправленныеЗначения(Шаблон, Документ, МассивПолей);
	КонецЕсли;
	ХранилищеОбщихНастроек.Сохранить("ШД_ФормированиеДокумента", "Шаблон", Шаблон);

	Если НеЗаполнены.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Документ сформирован, но не заполнены поля: %1. Их можно заполнить в таблице и сформировать документ еще раз.'"),
			СтрСоединить(НеЗаполнены, "; ")));
	КонецЕсли;

	Возврат Новый Структура("Адрес, ИмяФайла",
		ПоместитьВоВременноеХранилище(Результат.ДвоичныеДанные, УникальныйИдентификатор),
		Результат.ИмяФайла);

КонецФункции

&НаСервере
Функция ШаблонПоУмолчанию()

	Последний = ХранилищеОбщихНастроек.Загрузить("ШД_ФормированиеДокумента", "Шаблон");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Шаблоны.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Шаблоны.Ссылка = &Последний
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	Справочник.ШД_ШаблоныДокументов КАК Шаблоны
	|ГДЕ
	|	НЕ Шаблоны.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Шаблоны.Наименование";
	Запрос.УстановитьПараметр("Последний", Последний);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.ШД_ШаблоныДокументов.ПустаяСсылка());

КонецФункции

&НаСервере
Процедура ОбработкаОповещенияНаСервере()

	Если Не ЗначениеЗаполнено(Шаблон) Или Шаблон.ПометкаУдаления Тогда
		Шаблон = ШаблонПоУмолчанию();
	КонецЕсли;
	ЗаполнитьПоля();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогПроверки(Форма)

	Пустых = Форма.Поля.НайтиСтроки(Новый Структура("Статус", "Пусто")).Количество();
	Проверить = Форма.Поля.НайтиСтроки(Новый Структура("Статус", "Проверить")).Количество();

	Если Форма.Поля.Количество() = 0 Тогда
		Текст = "";
	ИначеЕсли Пустых + Проверить = 0 Тогда
		Текст = НСтр("ru = 'Все поля заполнены данными из 1С.'");
	Иначе
		Текст = СтрШаблон(НСтр("ru = 'Требуют внимания: не заполнено - %1, проверить - %2.'"), Пустых, Проверить);
	КонецЕсли;
	Форма.Элементы.ИтогПроверки.Заголовок = Текст;

КонецПроцедуры

&НаСервере
Процедура НастроитьОформление()

	Элементы.ИтогПроверки.Шрифт = Новый Шрифт(, , Истина);
	ДобавитьЦветСтроки("Пусто", Новый Цвет(255, 215, 215));
	ДобавитьЦветСтроки("Проверить", Новый Цвет(255, 240, 180));
	ДобавитьЦветСтроки("Запомнено", Новый Цвет(215, 240, 215));

	// Исправленные пользователем значения выделяем жирным шрифтом.
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Поля.Изменено");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 1;
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПоляЗначение.Имя);

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ДобавитьЦветСтроки(Статус, Цвет)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Поля.Статус");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Статус;
	Для Каждого ИмяЭлемента Из СтрРазделить("ПоляПредставление,ПоляЗначение,ПоляИсточник,ПоляПояснение", ",") Цикл
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	КонецЦикла;

КонецПроцедуры

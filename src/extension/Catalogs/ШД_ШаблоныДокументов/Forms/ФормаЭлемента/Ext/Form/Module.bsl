#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СправкаПоПолям = ШД_ФормированиеДокументов.ТекстСправкиПоПолям();
	Если Объект.Ссылка.Пустая() Тогда
		ОбновитьОписаниеФайла();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ДвоичныеДанные = ТекущийОбъект.ФайлШаблона.Получить();
	Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		АдресФайлаШаблона = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	Иначе
		АдресФайлаШаблона = "";
	КонецЕсли;
	ФайлШаблонаИзменен = Ложь;
	ОбновитьОписаниеФайла();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ФайлШаблонаИзменен И ЭтоАдресВременногоХранилища(АдресФайлаШаблона) Тогда
		ТекущийОбъект.ФайлШаблона = Новый ХранилищеЗначения(
			ПолучитьИзВременногоХранилища(АдресФайлаШаблона), Новый СжатиеДанных(9));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ФайлШаблонаИзменен = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Оповестить("Запись_ШД_ШаблоныДокументов", , Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)

	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Фильтр = НСтр("ru = 'Документ Word (*.docx)|*.docx'");
	ПараметрыЗагрузки.Диалог.Заголовок = НСтр("ru = 'Выберите файл шаблона'");

	ФайловаяСистемаКлиент.ЗагрузитьФайл(Новый ОписаниеОповещения("ЗагрузитьФайлЗавершение", ЭтотОбъект),
		ПараметрыЗагрузки);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайл(Команда)

	Если Не ЗначениеЗаполнено(АдресФайлаШаблона) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Файл шаблона еще не загружен.'"));
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = ФайловаяСистемаКлиент.ПараметрыОткрытияФайла();
	ПараметрыОткрытия.ДляРедактирования = Истина;
	ФайловаяСистемаКлиент.ОткрытьФайл(АдресФайлаШаблона,
		Новый ОписаниеОповещения("ОткрытьФайлЗавершение", ЭтотОбъект), ИмяФайлаШаблона(), ПараметрыОткрытия);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайл(Команда)

	Если Не ЗначениеЗаполнено(АдресФайлаШаблона) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Файл шаблона еще не загружен.'"));
		Возврат;
	КонецЕсли;

	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайлаШаблона, ИмяФайлаШаблона());

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыПоШаблону(Команда)

	Если Не ЗначениеЗаполнено(АдресФайлаШаблона) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала загрузите файл шаблона.'"));
		Возврат;
	КонецЕсли;

	Добавлено = ДобавитьПараметрыИзШаблона();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Параметры шаблона'"), ,
		СтрШаблон(НСтр("ru = 'Добавлено новых параметров: %1'"), Добавлено));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗагрузитьФайлЗавершение(ПомещенныйФайл, ДополнительныеПараметры) Экспорт

	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = СтрЗаменить(ПомещенныйФайл.Имя, "/", "\");
	ЧастиПути = СтрРазделить(ИмяФайла, "\", Ложь);
	Если ЧастиПути.Количество() > 0 Тогда
		ИмяФайла = ЧастиПути[ЧастиПути.ВГраница()];
	КонецЕсли;

	Добавлено = ПрименитьЗагруженныйФайл(ПомещенныйФайл.Хранение, ИмяФайла);
	Если Добавлено > 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Шаблон загружен'"), ,
			СтрШаблон(НСтр("ru = 'Найдено новых параметров: %1. Проверьте их на закладке «Параметры шаблона».'"), Добавлено));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлЗавершение(ФайлИзменен, ДополнительныеПараметры) Экспорт

	Если ФайлИзменен = Истина Тогда
		ФайлШаблонаИзменен = Истина;
		Модифицированность = Истина;
		ДобавитьПараметрыИзШаблона();
		ОбновитьОписаниеФайла();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПрименитьЗагруженныйФайл(Адрес, ИмяФайла)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	// Проверка, что это документ Word: при ошибке будет вызвано исключение с понятным текстом.
	ШД_ФормированиеДокументов.ИменаПолейДвоичныхДанных(ДвоичныеДанные);

	АдресФайлаШаблона = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	ФайлШаблонаИзменен = Истина;
	Модифицированность = Истина;

	Объект.ИмяФайлаШаблона = ИмяФайла;
	Если ПустаяСтрока(Объект.Наименование) Тогда
		Объект.Наименование = СтрЗаменить(ИмяФайла, ".docx", "");
	КонецЕсли;

	Добавлено = ДобавитьПараметрыИзШаблона();
	ОбновитьОписаниеФайла();

	Возврат Добавлено;

КонецФункции

// Добавляет в табличную часть поля шаблона, которые не рассчитываются программой автоматически.
//
&НаСервере
Функция ДобавитьПараметрыИзШаблона()

	Если Не ЭтоАдресВременногоХранилища(АдресФайлаШаблона) Тогда
		Возврат 0;
	КонецЕсли;

	Добавлено = 0;
	Имена = ШД_ФормированиеДокументов.ИменаПолейДвоичныхДанных(ПолучитьИзВременногоХранилища(АдресФайлаШаблона));
	Для Каждого Имя Из Имена Цикл
		Если ШД_ФормированиеДокументов.ЭтоСтандартноеПоле(Имя)
			Или Объект.Параметры.НайтиСтроки(Новый Структура("Имя", Имя)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		НовыйПараметр = Объект.Параметры.Добавить();
		НовыйПараметр.Имя = Имя;
		НовыйПараметр.Представление = Имя;
		НовыйПараметр.Запоминать = Истина;
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Если Добавлено > 0 Тогда
		Модифицированность = Истина;
	КонецЕсли;

	Возврат Добавлено;

КонецФункции

&НаСервере
Процедура ОбновитьОписаниеФайла()

	Если Не ЭтоАдресВременногоХранилища(АдресФайлаШаблона) Тогда
		ОписаниеФайла = НСтр("ru = 'Файл шаблона не загружен. Нажмите «Загрузить из файла...» и выберите документ Word (.docx), в котором изменяемые места заменены полями вида {{Организация.Наименование}}.'");
		Возврат;
	КонецЕсли;

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаШаблона);
	Попытка
		КоличествоПолей = ШД_ФормированиеДокументов.ИменаПолейДвоичныхДанных(ДвоичныеДанные).Количество();
	Исключение
		КоличествоПолей = 0;
	КонецПопытки;

	ОписаниеФайла = СтрШаблон(НСтр("ru = 'Файл: %1 (%2 КБ), полей в шаблоне: %3'"),
		?(ПустаяСтрока(Объект.ИмяФайлаШаблона), "шаблон.docx", Объект.ИмяФайлаШаблона),
		Формат(Окр(ДвоичныеДанные.Размер() / 1024, 0, РежимОкругления.Окр15как20), "ЧН=0"),
		КоличествоПолей);

КонецПроцедуры

&НаКлиенте
Функция ИмяФайлаШаблона()

	Если ПустаяСтрока(Объект.ИмяФайлаШаблона) Тогда
		Возврат "Шаблон.docx";
	КонецЕсли;
	Возврат Объект.ИмяФайлаШаблона;

КонецФункции

#КонецОбласти
